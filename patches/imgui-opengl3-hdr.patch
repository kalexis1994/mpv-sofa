+// [mpv-sofa] HDR scRGB compositing support - see imgui_impl_opengl3.h.
+void    ImGui_ImplOpenGL3_SetHdrColorDefaults(int mode, float sdr_scale)
+{
+    ImGui_ImplOpenGL3_Data* bd = ImGui_ImplOpenGL3_GetBackendData();
+    if (!bd) return;
+    bd->HdrDefaultMode = mode;
+    bd->HdrDefaultScale = sdr_scale;
+}
+
+void    ImGui_ImplOpenGL3_SetHdrColorMode(int mode, float sdr_scale)
+{
+    // Immediate uniform update; valid while the backend's program is bound,
+    // i.e. from within an ImDrawList user callback during RenderDrawData.
+    ImGui_ImplOpenGL3_Data* bd = ImGui_ImplOpenGL3_GetBackendData();
+    if (!bd || bd->AttribLocationColorMode == -1) return;
+    glUniform1i(bd->AttribLocationColorMode, mode);
+    glUniform1i(bd->AttribLocationSdrScaleMilli,
+                (int)(sdr_scale * 1000.0f + 0.5f));
+}
+
 void    ImGui_ImplOpenGL3_DestroyDeviceObjects()
 {
     ImGui_ImplOpenGL3_InitLoader();
