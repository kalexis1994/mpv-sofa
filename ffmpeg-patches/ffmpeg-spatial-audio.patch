+/** number of bits used for VLC lookup - longest Huffman code is 9 */
+#if ARCH_ARM
+#define VLC_BITS            5
+#define VLC_STATIC_SIZE     64
+#else
+#define VLC_BITS            9
+#define VLC_STATIC_SIZE     512
+#endif
+
+typedef struct SubStream {
+    /// Set if a valid restart header has been read. Otherwise the substream cannot be decoded.
+    uint8_t     restart_seen;
+    /// Set if end of stream is encountered
+    uint8_t     end_of_stream;
+
+    //@{
+    /** restart header data */
+    /// The type of noise to be used in the rematrix stage.
+    uint16_t    noise_type;
+
+    /// The index of the first channel coded in this substream.
+    uint8_t     min_channel;
+    /// The index of the last channel coded in this substream.
+    uint8_t     max_channel;
+    /// The coded channels mask in this substream.
+    uint64_t    coded_channels;
+    /// The number of channels input into the rematrix stage.
+    uint8_t     max_matrix_channel;
+    /// For each channel output by the matrix, the output channel to map it to
+    uint8_t     ch_assign[MAX_CHANNELS];
+    /// The channel layout for this substream
+    uint64_t    mask;
+    /// The matrix encoding mode for this substream
+    enum AVMatrixEncoding matrix_encoding;
+    enum AVMatrixEncoding prev_matrix_encoding;
+
+    /// Channel coding parameters for channels in the substream
+    ChannelParams channel_params[MAX_CHANNELS];
+
+    /// The left shift applied to random noise in 0x31ea substreams.
+    uint8_t     noise_shift;
+    /// The current seed value for the pseudorandom noise generator(s).
+    uint32_t    noisegen_seed;
+
+    /// Set if the substream contains extra info to check the size of VLC blocks.
+    uint8_t     data_check_present;
+
+    /// Bitmask of which parameter sets are conveyed in a decoding parameter block.
+    uint8_t     param_presence_flags;
+    //@}
+
+    //@{
+    /** matrix data */
+
+    /// Number of matrices to be applied.
+    uint8_t     num_primitive_matrices;
+
+    /// matrix output channel
+    uint8_t     matrix_out_ch[MAX_MATRICES];
+
+    /// Whether the LSBs of the matrix output are encoded in the bitstream.
+    /// For 0x31ec substreams, this is 0-3 (2 bits); for standard, 0-1 (1 bit).
+    uint8_t     lsb_bypass[MAX_MATRICES];
+    /// Matrix coefficients, stored as 2.14 (standard) or 2.18 (0x31ec) fixed point.
+    DECLARE_ALIGNED(32, int32_t, matrix_coeff)[MAX_MATRICES][MAX_CHANNELS];
+    /// Left shift to apply to noise values in 0x31eb substreams.
+    uint8_t     matrix_noise_shift[MAX_MATRICES];
+
+    /// 0x31ec-specific fields for interpolating matrices
+    uint8_t     matrix_coeff_frac_bits[MAX_MATRICES];
+    int8_t      matrix_coeff_shift[MAX_MATRICES];
+    uint16_t    matrix_coeff_mask[MAX_MATRICES];
+    DECLARE_ALIGNED(32, int32_t, delta_matrix_coeff)[MAX_MATRICES][MAX_CHANNELS];
+    uint8_t     delta_matrix_coeff_bits[MAX_MATRICES];
+    uint8_t     delta_matrix_coeff_prec[MAX_MATRICES];
+    uint16_t    substream_type;
+    //@}
+
+    /// Left shift to apply to Huffman-decoded residuals.
+    uint8_t     quant_step_size[MAX_CHANNELS];
+
+    /// number of PCM samples in current audio block
+    uint16_t    blocksize;
+    /// Number of PCM samples decoded so far in this frame.
+    uint16_t    blockpos;
+
+    /// Left shift to apply to decoded PCM values to get final 24-bit output.
+    int8_t      output_shift[MAX_CHANNELS];
+
+    /// Running XOR of all output samples.
+    int32_t     lossless_check_data;
+
+} SubStream;
+
+typedef struct MLPDecodeContext {
+    const AVClass  *class;
+    AVCodecContext *avctx;
+
+    AVChannelLayout downmix_layout;
+
+    /// Enable spatial object extraction (decode 4th substream)
+    int         extract_objects;
+
+    /// Current access unit being read has a major sync.
+    int         is_major_sync_unit;
+
+    /// Size of the major sync unit, in bytes
+    int         major_sync_header_size;
+
+    /// Set if a valid major sync block has been read. Otherwise no decoding is possible.
+    uint8_t     params_valid;
+
+    /// Number of substreams contained within this stream.
+    uint8_t     num_substreams;
+
+    /// Which substream of substreams carry 16-channel presentation
+    uint8_t     extended_substream_info;
+
+    /// Which substream of substreams carry 2/6/8-channel presentation
+    uint8_t     substream_info;
+
+    /// Index of the last substream to decode - further substreams are skipped.
+    uint8_t     max_decoded_substream;
+
+    /// Stream needs channel reordering to comply with FFmpeg's channel order
+    uint8_t     needs_reordering;
+
+    /// number of PCM samples contained in each frame
+    int         access_unit_size;
+    /// next power of two above the number of samples in each frame
+    int         access_unit_size_pow2;
+
+    SubStream   substream[MAX_SUBSTREAMS];
+
+    int         matrix_changed;
+    int         filter_changed[MAX_CHANNELS][NUM_FILTERS];
+
+    int8_t      noise_buffer[MAX_BLOCKSIZE_POW2];
+    int8_t      bypassed_lsbs[MAX_BLOCKSIZE][MAX_CHANNELS];
+    DECLARE_ALIGNED(32, int32_t, sample_buffer)[MAX_BLOCKSIZE][MAX_CHANNELS];
+
+    MLPDSPContext dsp;
+    int32_t (*pack_output)(int32_t lossless_check_data,
+                           uint16_t blockpos,
+                           int32_t (*sample_buffer)[MAX_CHANNELS],
+                           void *data,
+                           uint8_t *ch_assign,
+                           int8_t *output_shift,
+                           uint8_t max_matrix_channel,
+                           int is32);
+
+    /// spatial 4th substream interpolating matrix state
+    int         spatial_substream_type;    ///< 0=normal, 1=0x31ec interpolating
+    int         atmos_num_matrices;
+    uint8_t     atmos_matrix_out_ch[MAX_MATRICES];
+    DECLARE_ALIGNED(32, int32_t, atmos_seed_coeff)[MAX_MATRICES][MAX_CHANNELS];
+    DECLARE_ALIGNED(32, int32_t, atmos_delta_coeff)[MAX_MATRICES][MAX_CHANNELS];
+
+    /// Saved bed audio from substream 2 for spatial merging.
+    /// The spatial interpolating rematrix needs the bed audio as input,
+    /// but substream 3's decode overwrites it with near-zero residuals.
+    DECLARE_ALIGNED(32, int32_t, bed_buffer)[MAX_BLOCKSIZE][MAX_CHANNELS];
+    unsigned int bed_blockpos;
+    unsigned int bed_max_ch;
+
+    /// Height channel crossfade state for AU boundary smoothing.
+    /// Saves the last SPATIAL_XFADE_LEN samples of each height channel
+    /// from the previous AU so we can crossfade at the next AU boundary.
+#define SPATIAL_XFADE_LEN 20
+    int32_t prev_height_tail[SPATIAL_XFADE_LEN][MAX_CHANNELS];
+    int     prev_height_tail_valid;
+
+    /// Per-block coefficient state for spatial interpolating rematrix.
+    /// Each AU can contain multiple blocks with different seed/delta;
+    /// we save per-block state here so output_data can apply rematrix
+    /// with the correct coefficients for each block's sample range.
+#define MAX_SPATIAL_BLOCKS_PER_AU 16
+    int spatial_num_blocks;
+    struct {
+        unsigned int start;   ///< first sample index within AU
+        unsigned int size;    ///< number of samples in this block
+        int num_matrices;
+        uint8_t out_ch[MAX_MATRICES];
+        int32_t seed[MAX_MATRICES][MAX_CHANNELS];
+        int32_t delta[MAX_MATRICES][MAX_CHANNELS];
+    } spatial_blk[MAX_SPATIAL_BLOCKS_PER_AU];
+
+} MLPDecodeContext;
