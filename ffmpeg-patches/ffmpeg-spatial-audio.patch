+void ff_mlp_rematrix_interp_channel(int32_t *samples,
+                                     const int32_t *seed_coeffs,
+                                     const int32_t *delta_coeffs,
+                                     unsigned int dest_ch,
+                                     uint16_t blockpos,
+                                     unsigned int maxchan,
+                                     int32_t mask)
+{
+    unsigned int src_ch, i;
+    for (i = 0; i < blockpos; i++) {
+        int64_t accum = 0;
+        /* Interpolated coefficient = seed + (delta * i) / blockpos
+         * Using 2.18 fixed-point: delta is the total change over the block. */
+        for (src_ch = 0; src_ch <= maxchan; src_ch++) {
+            int32_t coeff = seed_coeffs[src_ch] +
+                            (int32_t)(((int64_t)delta_coeffs[src_ch] * i) / blockpos);
+            accum += (int64_t)samples[src_ch] * coeff;
+        }
+        samples[dest_ch] = (int32_t)((accum >> 18) & mask);
+        samples += MAX_CHANNELS;
+    }
+}
