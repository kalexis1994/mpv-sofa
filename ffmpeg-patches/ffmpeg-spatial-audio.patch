+/* Parse full object coding payload and write mixing matrix to g_objcoding_data */
+static int eac3_parse_objcoding(const uint8_t *payload, int payload_size) {
+    EmdfBitReader br;
+    emdf_br_init(&br, payload, payload_size);
+
+    /* object coding header (Section 6.2.2) */
+    uint32_t dmx_config_idx = emdf_br_read(&br, 3);
+    uint32_t num_objects_bits = emdf_br_read(&br, 6);
+    uint32_t ext_config_idx = emdf_br_read(&br, 3);
+
+    int num_objects = (int)num_objects_bits + 1;
+    if (num_objects > OBJCODING_MAX_OBJECTS) num_objects = OBJCODING_MAX_OBJECTS;
+
+    /* Table 48: num_channels from dmx_config_idx */
+    int num_channels;
+    if (dmx_config_idx == 0 || dmx_config_idx == 3)
+        num_channels = 5;
+    else if (dmx_config_idx <= 4)
+        num_channels = 7;
+    else
+        return -1; /* reserved */
+
+    /* object coding info (Section 6.2.3) */
+    uint32_t clipgain_x = emdf_br_read(&br, 3);
+    uint32_t clipgain_y = emdf_br_read(&br, 5);
+    emdf_br_read(&br, 10); /* seq_count_bits */
+    float clipgain = (1.0f + (float)clipgain_y / 32.0f) * (float)(1 << clipgain_x);
+
+    /* Per-object info */
+    int b_obj_present[OBJCODING_MAX_OBJECTS];
+    int num_bands_idx[OBJCODING_MAX_OBJECTS];
+    int num_bands[OBJCODING_MAX_OBJECTS];
+    int b_sparse[OBJCODING_MAX_OBJECTS];
+    int quant_idx[OBJCODING_MAX_OBJECTS];
+    int slope_idx[OBJCODING_MAX_OBJECTS];
+    int num_dpoints[OBJCODING_MAX_OBJECTS];
+    int offset_ts[OBJCODING_MAX_OBJECTS][2];
+
+    for (int obj = 0; obj < num_objects; obj++) {
+        b_obj_present[obj] = emdf_br_read(&br, 1);
+        if (b_obj_present[obj]) {
+            num_bands_idx[obj] = emdf_br_read(&br, 3);
+            num_bands[obj] = objcoding_num_bands_table[num_bands_idx[obj]];
+            b_sparse[obj] = emdf_br_read(&br, 1);
+            quant_idx[obj] = emdf_br_read(&br, 1);
+
+            /* object coding data_point_info (Section 6.2.4) */
+            slope_idx[obj] = emdf_br_read(&br, 1);
+            num_dpoints[obj] = emdf_br_read(&br, 1) + 1;
+
+            if (slope_idx[obj] == 1) { /* steep: read timeslot offsets */
+                for (int dp = 0; dp < num_dpoints[obj]; dp++)
+                    offset_ts[obj][dp] = emdf_br_read(&br, 5) + 1;
+            }
+        } else {
+            num_bands_idx[obj] = 0;
+            num_bands[obj] = 1;
+            b_sparse[obj] = 0;
+            quant_idx[obj] = 0;
+            slope_idx[obj] = 0;
+            num_dpoints[obj] = 1;
+            offset_ts[obj][0] = 0;
+            offset_ts[obj][1] = 0;
+        }
+    }
+
+    /* object coding data (Section 6.2.5): Huffman decode all objects */
+    /* Use static arrays to keep stack usage bounded */
+    static int objcoding_ch_idx[OBJCODING_MAX_OBJECTS][2][OBJCODING_MAX_BANDS];
+    static int objcoding_vec[OBJCODING_MAX_OBJECTS][2][OBJCODING_MAX_BANDS];
+    static int objcoding_mtx[OBJCODING_MAX_OBJECTS][2][OBJCODING_MAX_CHANNELS][OBJCODING_MAX_BANDS];
+
+    memset(objcoding_ch_idx, 0, sizeof(objcoding_ch_idx));
+    memset(objcoding_vec, 0, sizeof(objcoding_vec));
+    memset(objcoding_mtx, 0, sizeof(objcoding_mtx));
+
+    for (int obj = 0; obj < num_objects; obj++) {
+        if (!b_obj_present[obj]) continue;
+        for (int dp = 0; dp < num_dpoints[obj]; dp++) {
+            if (emdf_br_left(&br) < 3) goto done;
+
+            if (b_sparse[obj]) {
+                /* Sparse: channel_idx + vec per band */
+                objcoding_ch_idx[obj][dp][0] = emdf_br_read(&br, 3);
+
+                const int (*idx_tbl)[2] = (num_channels == 5) ?
+                    objcoding_huff_5ch_pos_idx_sparse : objcoding_huff_7ch_pos_idx_sparse;
+                for (int pb = 1; pb < num_bands[obj]; pb++)
+                    objcoding_ch_idx[obj][dp][pb] = objcoding_huff_decode(&br, idx_tbl);
+
+                const int (*vec_tbl)[2] = (quant_idx[obj] == 0) ?
+                    objcoding_huff_coarse_coeff_sparse : objcoding_huff_fine_coeff_sparse;
+                for (int pb = 0; pb < num_bands[obj]; pb++)
+                    objcoding_vec[obj][dp][pb] = objcoding_huff_decode(&br, vec_tbl);
+            } else {
+                /* Dense: full matrix ch×band */
+                const int (*mtx_tbl)[2] = (quant_idx[obj] == 0) ?
+                    objcoding_huff_coarse_generic : objcoding_huff_fine_generic;
+                for (int ch = 0; ch < num_channels; ch++)
+                    for (int pb = 0; pb < num_bands[obj]; pb++)
+                        objcoding_mtx[obj][dp][ch][pb] = objcoding_huff_decode(&br, mtx_tbl);
+            }
+        }
+    }
+
+    /* Differential decode + dequantize + interpolate (Pseudocodes 2-6) */
+    {
+        static int objcoding_mix_q[OBJCODING_MAX_OBJECTS][2][OBJCODING_MAX_CHANNELS][OBJCODING_MAX_BANDS];
+        static float objcoding_mix_dq[OBJCODING_MAX_OBJECTS][2][OBJCODING_MAX_CHANNELS][OBJCODING_MAX_BANDS];
+        int num_timeslots = OBJCODING_MAX_TIMESLOTS; /* 24 for 1536/64 */
+
+        for (int obj = 0; obj < num_objects; obj++) {
+            if (!b_obj_present[obj]) continue;
+            int nquant = (quant_idx[obj] == 0) ? 96 : 192;
+
+            /* Pseudocode 2 (sparse) / Pseudocode 3 (dense) */
+            for (int dp = 0; dp < num_dpoints[obj]; dp++) {
+                if (b_sparse[obj]) {
+                    int offset = (quant_idx[obj] == 0) ? 50 : 100;
+                    for (int pb = 0; pb < num_bands[obj]; pb++) {
+                        int ch_mod;
+                        if (pb == 0)
+                            ch_mod = objcoding_ch_idx[obj][dp][0];
+                        else
+                            ch_mod = (objcoding_ch_idx[obj][dp][pb - 1] +
+                                      objcoding_ch_idx[obj][dp][pb]) % num_channels;
+
+                        for (int ch = 0; ch < num_channels; ch++) {
+                            if (ch == ch_mod) {
+                                if (pb == 0)
+                                    objcoding_mix_q[obj][dp][ch][pb] =
+                                        (offset + objcoding_vec[obj][dp][pb]) % nquant;
+                                else
+                                    objcoding_mix_q[obj][dp][ch][pb] =
+                                        (objcoding_mix_q[obj][dp][ch][pb - 1] +
+                                         objcoding_vec[obj][dp][pb]) % nquant;
+                            } else {
+                                objcoding_mix_q[obj][dp][ch][pb] = offset;
+                            }
+                        }
+                    }
+                } else {
+                    int offset = (quant_idx[obj] == 0) ? 48 : 96;
+                    for (int ch = 0; ch < num_channels; ch++) {
+                        objcoding_mix_q[obj][dp][ch][0] =
+                            (offset + objcoding_mtx[obj][dp][ch][0]) % nquant;
+                        for (int pb = 1; pb < num_bands[obj]; pb++)
+                            objcoding_mix_q[obj][dp][ch][pb] =
+                                (objcoding_mix_q[obj][dp][ch][pb - 1] +
+                                 objcoding_mtx[obj][dp][ch][pb]) % nquant;
+                    }
+                }
+            }
+
+            /* Pseudocode 5: dequantize */
+            for (int dp = 0; dp < num_dpoints[obj]; dp++)
+                for (int ch = 0; ch < num_channels; ch++)
+                    for (int pb = 0; pb < num_bands[obj]; pb++)
+                        objcoding_mix_dq[obj][dp][ch][pb] =
+                            (float)(objcoding_mix_q[obj][dp][ch][pb] - nquant / 2) *
+                            820.0f / (4096.0f * (1 + quant_idx[obj]));
+        }
+
+        /* Pseudocode 6: temporal interpolation + band→subband expansion */
+        for (int obj = 0; obj < num_objects; obj++) {
+            if (!b_obj_present[obj]) {
+                /* Non-present: fade prev to zero */
+                for (int ch = 0; ch < num_channels; ch++)
+                    for (int sb = 0; sb < 64; sb++) {
+                        float prev = objcoding_mix_mtx_prev[obj][ch][sb];
+                        for (int ts = 0; ts < num_timeslots; ts++)
+                            g_objcoding_data.mix_mtx[obj][ts][ch][sb] =
+                                prev * (1.0f - (float)(ts + 1) / num_timeslots);
+                        objcoding_mix_mtx_prev[obj][ch][sb] = 0;
+                    }
+                continue;
+            }
+
+            int nbi = num_bands_idx[obj];
+            for (int ch = 0; ch < num_channels; ch++) {
+                for (int sb = 0; sb < 64; sb++) {
+                    int pb = objcoding_sb_to_pb[nbi][sb];
+                    float prev_val = objcoding_mix_mtx_prev[obj][ch][sb];
+
+                    for (int ts = 0; ts < num_timeslots; ts++) {
+                        float val;
+                        if (slope_idx[obj] == 0) {
+                            /* Smooth: linear interpolation */
+                            if (num_dpoints[obj] == 1) {
+                                float delta = objcoding_mix_dq[obj][0][ch][pb] - prev_val;
+                                val = prev_val + (ts + 1) * delta / num_timeslots;
+                            } else {
+                                int ts_2 = num_timeslots / 2;
+                                if (ts < ts_2) {
+                                    float delta = objcoding_mix_dq[obj][0][ch][pb] - prev_val;
+                                    val = prev_val + (ts + 1) * delta / ts_2;
+                                } else {
+                                    float delta = objcoding_mix_dq[obj][1][ch][pb] -
+                                                  objcoding_mix_dq[obj][0][ch][pb];
+                                    val = objcoding_mix_dq[obj][0][ch][pb] +
+                                          (ts - ts_2 + 1) * delta / (num_timeslots - ts_2);
+                                }
+                            }
+                        } else {
+                            /* Steep: step transition */
+                            if (num_dpoints[obj] == 1) {
+                                val = (ts < offset_ts[obj][0]) ?
+                                    prev_val : objcoding_mix_dq[obj][0][ch][pb];
+                            } else {
+                                if (ts < offset_ts[obj][0])
+                                    val = prev_val;
+                                else if (ts < offset_ts[obj][1])
+                                    val = objcoding_mix_dq[obj][0][ch][pb];
+                                else
+                                    val = objcoding_mix_dq[obj][1][ch][pb];
+                            }
+                        }
+                        g_objcoding_data.mix_mtx[obj][ts][ch][sb] = val;
+                    }
+                    /* Update prev for next frame */
+                    objcoding_mix_mtx_prev[obj][ch][sb] =
+                        objcoding_mix_dq[obj][num_dpoints[obj] - 1][ch][pb];
+                }
+            }
+        }
+
+        g_objcoding_data.num_objects = num_objects;
+        g_objcoding_data.num_channels = num_channels;
+        g_objcoding_data.num_timeslots = num_timeslots;
+        g_objcoding_data.clipgain = clipgain;
+        atomic_store(&g_objcoding_data.updated, 1);
+    }
+
+done:
+    /* Debug: log first few object coding extractions */
+    {
+        static int objcoding_log_count = 0;
+        if (objcoding_log_count < 5) {
+            FILE *dbg = fopen("objcoding_parse_debug.txt", "a");
+            if (dbg) {
+                fprintf(dbg, "OBJCODING[%d]: %d obj, %d ch, dmx=%d, clipgain=%.2f\n",
+                        objcoding_log_count, num_objects, num_channels,
+                        dmx_config_idx, clipgain);
+                for (int obj = 0; obj < num_objects && obj < 4; obj++)
+                    fprintf(dbg, "  obj[%d] pres=%d bands=%d sparse=%d quant=%d "
+                            "slope=%d dp=%d mtx[0][0][0]=%.4f\n",
