+
+/** Noise generation functions.
+ *  I'm not sure what these are for - they seem to be some kind of pseudorandom
+ *  sequence generators, used to generate noise data which is used when the
+ *  channels are rematrixed. I'm not sure if they provide a practical benefit
+ *  to compression, or just obfuscate the decoder. Are they for some kind of
+ *  dithering? */
+
+/** Generate two channels of noise, used in the matrix when
+ *  restart sync word == 0x31ea. */
+
+static void generate_2_noise_channels(MLPDecodeContext *m, unsigned int substr)
+{
+    SubStream *s = &m->substream[substr];
+    unsigned int i;
+    uint32_t seed = s->noisegen_seed;
+    unsigned int maxchan = s->max_matrix_channel;
+
+    /* Noise channels occupy maxchan+1 and maxchan+2 in sample_buffer.
+     * If there is no room (e.g. 16-channel spatial), skip generation
+     * to avoid buffer overflow.  The caller must not increment maxchan. */
+    if (maxchan + 2 >= MAX_CHANNELS) {
+        /* Still advance the seed so that subsequent blocks stay in sync */
+        for (i = 0; i < s->blockpos; i++) {
+            uint16_t seed_shr7 = seed >> 7;
+            seed = (seed << 16) ^ seed_shr7 ^ (seed_shr7 << 5);
+        }
+        s->noisegen_seed = seed;
+        return;
+    }
+
+    for (i = 0; i < s->blockpos; i++) {
+        uint16_t seed_shr7 = seed >> 7;
+        m->sample_buffer[i][maxchan+1] = ((int8_t)(seed >> 15)) * (1 << s->noise_shift);
+        m->sample_buffer[i][maxchan+2] = ((int8_t) seed_shr7)   * (1 << s->noise_shift);
+
+        seed = (seed << 16) ^ seed_shr7 ^ (seed_shr7 << 5);
+    }
+
+    s->noisegen_seed = seed;
+}
+
+/** Generate a block of noise, used when restart sync word == 0x31eb. */
+
+static void fill_noise_buffer(MLPDecodeContext *m, unsigned int substr)
+{
+    SubStream *s = &m->substream[substr];
+    unsigned int i;
+    uint32_t seed = s->noisegen_seed;
+
+    for (i = 0; i < m->access_unit_size_pow2; i++) {
+        uint8_t seed_shr15 = seed >> 15;
+        m->noise_buffer[i] = noise_table[seed_shr15];
+        seed = (seed << 8) ^ seed_shr15 ^ (seed_shr15 << 5);
+    }
+
+    s->noisegen_seed = seed;
+}
+
+/** Write the audio data into the output buffer. */
+
+static int output_data(MLPDecodeContext *m, unsigned int substr,
+                       AVFrame *frame, int *got_frame_ptr)
+{
+    AVCodecContext *avctx = m->avctx;
+    SubStream *s = &m->substream[substr];
+    unsigned int mat;
+    unsigned int maxchan;
+    int ret;
+    int is32 = (m->avctx->sample_fmt == AV_SAMPLE_FMT_S32);
+
+    if (m->extract_objects) {
+        static int od_count = 0;
+        od_count++;
+
+        /* Log every frame for the first 10, then every 500th. */
+        if (od_count <= 10 || od_count % 500 == 0)
+            av_log(avctx, AV_LOG_WARNING,
+                   "output_data[%d]: substr=%u max_matrix_ch=%u blockpos=%u "
+                   "noise_type=%d ch_layout=%d atmos_type=%d bed_blockpos=%u\n",
+                   od_count, substr, s->max_matrix_channel, s->blockpos,
+                   s->noise_type, avctx->ch_layout.nb_channels,
+                   m->spatial_substream_type, m->bed_blockpos);
+
+        /* ANOMALY: blockpos mismatch between bed and spatial. */
+        if (substr >= 3 && m->bed_blockpos > 0 &&
+            s->blockpos != m->bed_blockpos)
+            av_log(avctx, AV_LOG_ERROR,
+                   "ANOMALY[%d]: blockpos MISMATCH atmos=%u bed=%u\n",
+                   od_count, s->blockpos, m->bed_blockpos);
+
+        /* ANOMALY: bed_blockpos is 0 when it shouldn't be. */
+        if (substr >= 3 && m->bed_blockpos == 0)
+            av_log(avctx, AV_LOG_ERROR,
+                   "ANOMALY[%d]: bed_blockpos is ZERO\n", od_count);
+
+        /* ANOMALY: fallback to bed substream (substr < 3). */
+        if (substr < 3 && m->max_decoded_substream >= 3)
+            av_log(avctx, AV_LOG_ERROR,
+                   "ANOMALY[%d]: FALLBACK to substr=%u (atmos failed)\n",
+                   od_count, substr);
+    }
+
+    if (!m->extract_objects &&
+        m->avctx->ch_layout.nb_channels != s->max_matrix_channel + 1) {
+        av_log(m->avctx, AV_LOG_ERROR, "channel count mismatch\n");
+        return AVERROR_INVALIDDATA;
+    }
+
+    if (!s->blockpos) {
+        av_log(avctx, AV_LOG_ERROR, "No samples to output.\n");
+        return AVERROR_INVALIDDATA;
+    }
+
+    /* When extract_objects is enabled, always output MAX_CHANNELS (16) for
+     * a stable channel count, even when falling back to substream 2.
+     * Unused channels will be zero (silent). */
+    unsigned int effective_max_ch = m->extract_objects
+                                    ? MAX_CHANNELS - 1
+                                    : s->max_matrix_channel;
+
+    /* The 0x31ec interpolating rematrix operates on the spatial substream's
+     * decoded residuals and produces the complete spatial-rendered audio in
+     * channels 0..max_matrix_channel.  This includes all spatial effects
+     * (objects, height channels) already mixed in. */
+
+    if (m->extract_objects && substr < 3) {
+        /* Fallback to bed substream (only used before first good frame).
+         * Zero-fill object channels, identity mapping. */
+        for (unsigned int ch = s->max_matrix_channel + 1; ch < MAX_CHANNELS; ch++) {
+            s->ch_assign[ch] = ch;
+            s->output_shift[ch] = 0;
+        }
+        for (unsigned int i = 0; i < s->blockpos; i++)
+            for (unsigned int ch = s->max_matrix_channel + 1; ch < MAX_CHANNELS; ch++)
+                m->sample_buffer[i][ch] = 0;
+        if (m->avctx->ch_layout.nb_channels != MAX_CHANNELS) {
+            av_channel_layout_uninit(&m->avctx->ch_layout);
+            av_channel_layout_default(&m->avctx->ch_layout, MAX_CHANNELS);
+        }
+    }
+
+    /* Generate noise and apply channel matrices. */
+    maxchan = s->max_matrix_channel;
+
+    if (!s->noise_type) {
+        generate_2_noise_channels(m, substr);
+        maxchan += 2;
+        if (maxchan >= MAX_CHANNELS)
+            maxchan = MAX_CHANNELS - 1;
+    } else {
+        fill_noise_buffer(m, substr);
+    }
+
+    /* Apply the channel matrices to reconstruct original audio samples. */
+    if (m->spatial_substream_type && substr >= 3) {
+        /* Bed injection + interpolating rematrix approach.
+         *
+         * Replace bed channel positions in sample_buffer with clean bed
+         * audio from bed_buffer (substream 2 post-rematrix), then apply
+         * substream 3's interpolating rematrix.  Height channels get their
+         * audio from the rematrix output.  Re-inject bed after rematrix
+         * to restore clean bed channels.
+         *
+         * Height channels need manual scaling by bed_shift (applied here
+         * in integer with clamp, then crossfaded at AU boundaries to
+         * smooth discontinuities from coefficient changes). */
+        int8_t bed_shift = 0;
+
+        if (m->bed_blockpos > 0) {
+            SubStream *bed_s_os = &m->substream[FFMIN(m->max_decoded_substream - 1, 2)];
+            AVChannelLayout bed_layout_os;
+            av_channel_layout_from_mask(&bed_layout_os, bed_s_os->mask);
+            for (int ci = 0; ci <= (int)s->max_matrix_channel &&
+                             ci < (int)FF_ARRAY_ELEMS(thd_channel_order); ci++) {
+                enum AVChannel ac = thd_channel_order[ci];
+                if (bed_s_os->mask & (1ULL << ac)) {
+                    int bed_idx = av_channel_layout_index_from_channel(
+                                      &bed_layout_os, ac);
+                    if (bed_idx >= 0) {
+                        int mat_ch = bed_s_os->ch_assign[bed_idx];
+                        bed_shift = bed_s_os->output_shift[mat_ch];
+                    }
+                    break;
+                }
+            }
+            av_channel_layout_uninit(&bed_layout_os);
+        }
+
+        /* Save spatial substream's parsed output_shift before overwriting.
+         * Height channels (produced by rematrix) need the spatial substream's
+         * own output_shift, not bed_shift, to avoid over-amplification. */
+        int8_t spatial_output_shift[MAX_CHANNELS];
+        memcpy(spatial_output_shift, s->output_shift, sizeof(spatial_output_shift));
+
+        /* Default all channels to bed_shift; bed channels are then restored
+         * to their individual values below, and height channels are restored
+         * to the spatial substream's parsed values. */
+        for (unsigned int ch = 0; ch < MAX_CHANNELS; ch++)
+            s->output_shift[ch] = bed_shift;
+
+        if (m->bed_blockpos > 0) {
+            SubStream *bed_s_sh = &m->substream[FFMIN(m->max_decoded_substream - 1, 2)];
+            AVChannelLayout bed_layout_sh;
+            av_channel_layout_from_mask(&bed_layout_sh, bed_s_sh->mask);
+            for (int ci = 0; ci <= (int)s->max_matrix_channel &&
+                             ci < (int)FF_ARRAY_ELEMS(thd_channel_order); ci++) {
+                enum AVChannel ac = thd_channel_order[ci];
+                if (bed_s_sh->mask & (1ULL << ac)) {
+                    int bed_idx = av_channel_layout_index_from_channel(
+                                      &bed_layout_sh, ac);
+                    if (bed_idx >= 0) {
+                        int mat_ch = bed_s_sh->ch_assign[bed_idx];
+                        s->output_shift[ci] = bed_s_sh->output_shift[mat_ch];
+                    }
+                } else {
+                    /* Non-bed channels (heights, objects): restore spatial
+                     * substream's parsed output_shift instead of bed_shift */
+                    s->output_shift[ci] = spatial_output_shift[ci];
+                }
+            }
+            av_channel_layout_uninit(&bed_layout_sh);
+        }
+
+        /* Per-block bed injection + interpolating rematrix + re-injection. */
+        if (m->bed_blockpos > 0 && m->spatial_num_blocks > 0) {
+            SubStream *bed_s_blk = &m->substream[FFMIN(m->max_decoded_substream - 1, 2)];
+            AVChannelLayout bed_layout_blk;
+            av_channel_layout_from_mask(&bed_layout_blk, bed_s_blk->mask);
+
+            for (int blk = 0; blk < m->spatial_num_blocks; blk++) {
+                unsigned int blk_start = m->spatial_blk[blk].start;
+                unsigned int blk_size  = m->spatial_blk[blk].size;
+                unsigned int blk_end   = FFMIN(blk_start + blk_size,
+                                               m->bed_blockpos);
+
+                /* Inject bed audio for this block's sample range */
+                for (int ci = 0; ci <= (int)s->max_matrix_channel &&
+                                 ci < (int)FF_ARRAY_ELEMS(thd_channel_order); ci++) {
+                    enum AVChannel ac = thd_channel_order[ci];
+                    if (bed_s_blk->mask & (1ULL << ac)) {
+                        int bed_idx = av_channel_layout_index_from_channel(
+                                          &bed_layout_blk, ac);
+                        if (bed_idx >= 0) {
+                            int mat_ch = bed_s_blk->ch_assign[bed_idx];
+                            for (unsigned int i = blk_start; i < blk_end; i++)
+                                m->sample_buffer[i][ci] = m->bed_buffer[i][mat_ch];
+                        }
+                    }
+                }
+
+                /* Run interpolating rematrix for this block only */
+                for (int mt = 0; mt < m->spatial_blk[blk].num_matrices; mt++) {
+                    unsigned int dest_ch = m->spatial_blk[blk].out_ch[mt];
+                    ff_mlp_rematrix_interp_channel(
+                        &m->sample_buffer[blk_start][0],
+                        m->spatial_blk[blk].seed[mt],
+                        m->spatial_blk[blk].delta[mt],
+                        dest_ch,
+                        blk_size,
+                        maxchan,
+                        MSB_MASK(s->quant_step_size[dest_ch]));
+                }
+
+                /* Re-inject bed audio */
+                for (int ci = 0; ci <= (int)s->max_matrix_channel &&
+                                 ci < (int)FF_ARRAY_ELEMS(thd_channel_order); ci++) {
+                    enum AVChannel ac = thd_channel_order[ci];
+                    if (bed_s_blk->mask & (1ULL << ac)) {
+                        int bed_idx = av_channel_layout_index_from_channel(
+                                          &bed_layout_blk, ac);
+                        if (bed_idx >= 0) {
+                            int mat_ch = bed_s_blk->ch_assign[bed_idx];
+                            for (unsigned int i = blk_start; i < blk_end; i++)
+                                m->sample_buffer[i][ci] = m->bed_buffer[i][mat_ch];
+                        }
+                    }
+                }
+            }
+
+            av_channel_layout_uninit(&bed_layout_blk);
+        }
+
+        /* Height channel scaling is done in float in af_hrtf.c using
+         * bed_shift exported via g_spatial_ext_coeff. No integer scaling
+         * or crossfade here — that avoids clipping and phaser artifacts. */
+
+        /* Export combined channel mask for the HRTF spatializer.
+         * Include bed speakers and height (TOP) speakers present in
+         * thd_channel_order[0..max_matrix_channel].  Exclude intermediary
+         * channels (FLC, FRC) that the rematrix uses as temporaries.
+         * Also zero out intermediary channels in sample_buffer so they
+         * don't produce unwanted audio in the spatializer. */
+        {
+            SubStream *bed_s_exp = &m->substream[FFMIN(m->max_decoded_substream - 1, 2)];
+            uint64_t combined_mask = 0;
+            for (int ci = 0; ci <= (int)s->max_matrix_channel &&
+                             ci < (int)FF_ARRAY_ELEMS(thd_channel_order); ci++) {
+                enum AVChannel ac = thd_channel_order[ci];
+                int in_bed = (bed_s_exp->mask & (1ULL << ac)) != 0;
+                int is_top = (ac == AV_CHAN_TOP_FRONT_LEFT  ||
+                              ac == AV_CHAN_TOP_FRONT_RIGHT ||
+                              ac == AV_CHAN_TOP_FRONT_CENTER ||
+                              ac == AV_CHAN_TOP_CENTER ||
+                              ac == AV_CHAN_TOP_BACK_LEFT ||
+                              ac == AV_CHAN_TOP_BACK_RIGHT ||
+                              ac == AV_CHAN_TOP_BACK_CENTER ||
+                              ac == AV_CHAN_TOP_SIDE_LEFT ||
+                              ac == AV_CHAN_TOP_SIDE_RIGHT);
+                if (in_bed || is_top)
+                    combined_mask |= (1ULL << ac);
+            }
+
+            /* Zero ALL channels not in combined_mask, including noise
+             * channels (max_matrix_channel+1 .. maxchan) and unused
+             * channels beyond maxchan.  The rematrix uses some of these
+             * as intermediaries; leaking them to the spatializer causes
+             * audible micro-clicks. */
+            for (unsigned int ci = 0; ci < MAX_CHANNELS; ci++) {
+                enum AVChannel ac = (ci < FF_ARRAY_ELEMS(thd_channel_order))
+                                        ? thd_channel_order[ci]
+                                        : AV_CHAN_NONE;
+                if (ac == AV_CHAN_NONE || !(combined_mask & (1ULL << ac))) {
+                    for (unsigned int i = 0; i < s->blockpos; i++)
+                        m->sample_buffer[i][ci] = 0;
+                }
+            }
+
+            g_spatial_ext_coeff.num_matrices = s->num_primitive_matrices;
+            g_spatial_ext_coeff.max_channel = maxchan;
+            g_spatial_ext_coeff.bed_mask = combined_mask;
+            g_spatial_ext_coeff.bed_shift = bed_shift;
+            for (mat = 0; mat < s->num_primitive_matrices; mat++) {
+                g_spatial_ext_coeff.out_ch[mat] = s->matrix_out_ch[mat];
+                for (unsigned int c = 0; c <= maxchan; c++)
+                    g_spatial_ext_coeff.coeff[mat][c] =
+                        s->matrix_coeff[mat][c];
+            }
+            atomic_store(&g_spatial_ext_coeff.updated, 1);
+        }
+    } else {
+        for (mat = 0; mat < s->num_primitive_matrices; mat++) {
+            unsigned int dest_ch = s->matrix_out_ch[mat];
+            m->dsp.mlp_rematrix_channel(&m->sample_buffer[0][0],
+                                        s->matrix_coeff[mat],
+                                        &m->bypassed_lsbs[0][mat],
+                                        m->noise_buffer,
+                                        s->num_primitive_matrices - mat,
+                                        dest_ch,
+                                        s->blockpos,
+                                        maxchan,
+                                        s->matrix_noise_shift[mat],
+                                        m->access_unit_size_pow2,
+                                        MSB_MASK(s->quant_step_size[dest_ch]));
+        }
+    }
+
+    /* get output buffer */
+    frame->nb_samples = s->blockpos;
+    if ((ret = ff_get_buffer(avctx, frame, 0)) < 0)
+        return ret;
+
+    if (m->extract_objects && m->bed_blockpos > 0 && substr >= 3) {
+        /* spatial: build ch_assign that maps from combined_mask bit order
+         * (what the spatializer expects) to thd_channel_order indices
+         * (where sample_buffer has the audio after the rematrix).
+         *
+         * combined_mask iterates bits in AVChannel order (FL=0,FR=1,...,BL=4,
+         * BR=5,...,SL=9,SR=10,...,TFL=12,TFR=14).  But sample_buffer uses
+         * thd_channel_order (FL=0,FR=1,...,SL=4,SR=5,TFL=6,TFR=7,...,BL=10,
+         * BR=11).  Without this mapping, height channels would be spatialized
+         * at the wrong positions (e.g. TFL at SL instead of overhead). */
+        uint8_t atmos_ch_assign[MAX_CHANNELS];
+
+        /* Find a zeroed channel to use as silence source for unused
+         * output positions.  FLC (thd index 8) is always zeroed since
+         * it's an intermediary not in combined_mask.  Fallback: last. */
+        uint8_t silent_ch = MAX_CHANNELS - 1;
+        for (unsigned int ci = 0;
+             ci < FF_ARRAY_ELEMS(thd_channel_order); ci++) {
+            enum AVChannel ac = thd_channel_order[ci];
+            if (!(g_spatial_ext_coeff.bed_mask & (1ULL << ac))) {
+                silent_ch = ci;
+                break;
+            }
+        }
+        for (int ch = 0; ch < MAX_CHANNELS; ch++)
+            atmos_ch_assign[ch] = silent_ch;
+
+        uint64_t cm = g_spatial_ext_coeff.bed_mask;
+        int out_pos = 0;
+        for (int bit = 0; bit < 64 && out_pos < MAX_CHANNELS; bit++) {
+            if (!(cm & (1ULL << bit)))
+                continue;
+            /* Find thd_channel_order index for this AVChannel */
+            int thd_idx = -1;
+            for (unsigned int ci = 0;
+                 ci < FF_ARRAY_ELEMS(thd_channel_order); ci++) {
+                if ((int)thd_channel_order[ci] == bit) {
+                    thd_idx = ci;
+                    break;
+                }
+            }
+            atmos_ch_assign[out_pos] = (thd_idx >= 0)
+                                           ? (uint8_t)thd_idx
+                                           : silent_ch;
+            out_pos++;
+        }
+
+        /* Diagnostic: log peak sample values per channel and ch_assign. */
+        {
+            static int diag_cnt = 0;
+            diag_cnt++;
+            if (diag_cnt <= 5 || diag_cnt % 200 == 0) {
+                av_log(avctx, AV_LOG_WARNING,
+                       "SPATIAL_DIAG[%d]: blkpos=%u nblks=%d bed_shift=%d maxchan=%u mask=0x%llx\n",
+                       diag_cnt, s->blockpos, m->spatial_num_blocks,
+                       (int)g_spatial_ext_coeff.bed_shift, maxchan, (unsigned long long)g_spatial_ext_coeff.bed_mask);
+                /* Peak per thd channel index */
+                for (unsigned int ci = 0; ci <= maxchan && ci < MAX_CHANNELS; ci++) {
+                    int32_t peak = 0;
+                    for (unsigned int i = 0; i < s->blockpos; i++) {
+                        int32_t v = m->sample_buffer[i][ci];
+                        if (v < 0) v = -v;
+                        if (v > peak) peak = v;
+                    }
+                    av_log(avctx, AV_LOG_WARNING,
+                           "  ch[%u] peak=%d oshift=%d assign[%u]=%u\n",
+                           ci, peak, s->output_shift[ci], ci, atmos_ch_assign[ci]);
+                }
+            }
+        }
+
+        s->lossless_check_data = m->pack_output(s->lossless_check_data,
+                                                s->blockpos,
+                                                m->sample_buffer,
+                                                frame->data[0],
+                                                atmos_ch_assign,
+                                                s->output_shift,
+                                                effective_max_ch,
+                                                is32);
+    } else if (0) {
+        /* Dead code: old merge approach kept for reference. */
+        uint8_t merged_ch_assign[MAX_CHANNELS];
+        int8_t  merged_output_shift[MAX_CHANNELS];
+        SubStream *bed_s = &m->substream[FFMIN(m->max_decoded_substream - 1, 2)];
+        unsigned int bed_nch = m->bed_max_ch + 1;
+
+        /* Re-identify height channels (TOP speakers only) */
+        int height_src2[MAX_CHANNELS];
+        enum AVChannel height_avch2[MAX_CHANNELS];
+        int nh2 = 0;
+        for (int ci = 0; ci <= (int)s->max_matrix_channel && ci < MAX_CHANNELS; ci++) {
+            enum AVChannel ac;
+            if (s->mask != 0) {
+                ac = thd_channel_layout_extract_channel(s->mask, ci);
+            } else if (ci < (int)FF_ARRAY_ELEMS(thd_channel_order)) {
+                ac = thd_channel_order[ci];
+            } else {
+                ac = AV_CHAN_NONE;
+            }
+            int is_top2 = (ac == AV_CHAN_TOP_FRONT_LEFT  ||
+                           ac == AV_CHAN_TOP_FRONT_RIGHT ||
+                           ac == AV_CHAN_TOP_FRONT_CENTER ||
+                           ac == AV_CHAN_TOP_CENTER ||
+                           ac == AV_CHAN_TOP_BACK_LEFT ||
+                           ac == AV_CHAN_TOP_BACK_RIGHT ||
+                           ac == AV_CHAN_TOP_BACK_CENTER ||
+                           ac == AV_CHAN_TOP_SIDE_LEFT ||
+                           ac == AV_CHAN_TOP_SIDE_RIGHT);
+            if (is_top2 && !(bed_s->mask & (1ULL << ac))) {
+                height_src2[nh2] = ci;
+                height_avch2[nh2] = ac;
+                nh2++;
+            }
+        }
+        if (nh2 > 8) nh2 = 8;
+
+        /* Build ch_assign and output_shift in combined_mask bit order.
+         * Bed channels use bed substream's output_shift (correct for
+         * bed_buffer data).  Height channels use spatial output_shift
+         * (they come from normalized temp_buf rematrix). */
+        uint64_t combined2 = bed_s->mask;
+        for (int h = 0; h < nh2; h++)
+            combined2 |= (1ULL << height_avch2[h]);
+
+        AVChannelLayout bed_layout2;
+        av_channel_layout_from_mask(&bed_layout2, bed_s->mask);
+
+        int total_out2 = 0;
+        for (int bit = 0; bit < 64 && total_out2 < MAX_CHANNELS; bit++) {
+            if (!(combined2 & (1ULL << bit)))
+                continue;
+            merged_ch_assign[total_out2] = total_out2; /* identity */
+            if (bed_s->mask & (1ULL << bit)) {
+                int bed_idx = av_channel_layout_index_from_channel(
+                                  &bed_layout2, (enum AVChannel)bit);
+                if (bed_idx >= 0) {
+                    int mat_ch = bed_s->ch_assign[bed_idx];
+                    merged_output_shift[total_out2] = bed_s->output_shift[mat_ch];
+                } else {
+                    merged_output_shift[total_out2] = 0;
+                }
+            } else {
+                merged_output_shift[total_out2] = 0;
+                for (int h2 = 0; h2 < nh2; h2++) {
+                    if ((int)height_avch2[h2] == bit) {
+                        merged_output_shift[total_out2] =
+                            s->output_shift[height_src2[h2]];
+                        break;
+                    }
+                }
+            }
+            total_out2++;
+        }
+        av_channel_layout_uninit(&bed_layout2);
+
+        /* Remaining: identity, zero shift */
+        for (int ch = total_out2; ch < MAX_CHANNELS; ch++) {
+            merged_ch_assign[ch] = ch;
+            merged_output_shift[ch] = 0;
+        }
+
+        /* Debug: log channel mapping */
+        {
+            static int atmos_dbg_count = 0;
+            static int atmos_dbg_periodic = 0;
+            atmos_dbg_periodic++;
+            /* Log first 3 frames in detail, then every 500 frames for peaks */
+            if (atmos_dbg_count < 3) {
+                atmos_dbg_count++;
+                av_log(m->avctx, AV_LOG_WARNING,
+                       "ATMOS MERGE: bed_nch=%u height=%d bed_mask=0x%llx "
+                       "atmos_mask=0x%llx combined=0x%llx num_mat=%u "
+                       "atmos_max_matrix_ch=%u\n",
+                       bed_nch, nh2,
+                       (unsigned long long)bed_s->mask,
+                       (unsigned long long)s->mask,
+                       (unsigned long long)g_spatial_ext_coeff.bed_mask,
+                       s->num_primitive_matrices,
+                       s->max_matrix_channel);
+                /* Log each spatial internal channel's AVChannel mapping */
+                av_log(m->avctx, AV_LOG_WARNING,
+                       "  atmos_ch_map:");
+                for (int ci = 0; ci <= (int)s->max_matrix_channel && ci < MAX_CHANNELS; ci++) {
+                    enum AVChannel ac;
+                    if (s->mask != 0) {
+                        ac = thd_channel_layout_extract_channel(s->mask, ci);
+                    } else if (ci < (int)FF_ARRAY_ELEMS(thd_channel_order)) {
+                        ac = thd_channel_order[ci];
+                    } else {
+                        ac = AV_CHAN_NONE;
+                    }
+                    int in_bed = (ac != AV_CHAN_NONE &&
+                                  (bed_s->mask & (1ULL << ac)));
+                    av_log(m->avctx, AV_LOG_WARNING,
+                           " [%d]=ch%d(%s)", ci, (int)ac,
+                           in_bed ? "BED" : "OBJ");
+                }
+                av_log(m->avctx, AV_LOG_WARNING, "\n");
+                /* Log matrix out_ch targets */
+                av_log(m->avctx, AV_LOG_WARNING,
+                       "  matrix_out_ch:");
+                for (unsigned int mt = 0; mt < s->num_primitive_matrices; mt++)
+                    av_log(m->avctx, AV_LOG_WARNING,
+                           " [%u]->%u", mt, s->matrix_out_ch[mt]);
+                av_log(m->avctx, AV_LOG_WARNING, "\n");
+                if (nh2 > 0) {
+                    av_log(m->avctx, AV_LOG_WARNING,
+                           "  height_src:");
+                    for (int h = 0; h < nh2; h++)
+                        av_log(m->avctx, AV_LOG_WARNING,
+                               " [%d]->ch%u", height_src2[h], bed_nch + h);
+                    av_log(m->avctx, AV_LOG_WARNING, "\n");
+                }
+                /* Log output peaks from sample_buffer (after merge) */
+                av_log(m->avctx, AV_LOG_WARNING,
+                       "  output_peaks:");
+                for (int ci = 0; ci < total_out2 && ci < MAX_CHANNELS; ci++) {
+                    int32_t peak = 0;
+                    for (unsigned int i = 0; i < FFMIN(s->blockpos, 40u); i++) {
+                        int32_t v = m->sample_buffer[i][ci];
+                        if (v < 0) v = -v;
+                        if (v > peak) peak = v;
+                    }
+                    av_log(m->avctx, AV_LOG_WARNING, " [%d]=%d", ci, peak);
+                }
+                av_log(m->avctx, AV_LOG_WARNING, "\n");
+                /* Log output_shift values for each output channel */
+                av_log(m->avctx, AV_LOG_WARNING,
+                       "  output_shift:");
+                for (int ci = 0; ci < total_out2; ci++)
+                    av_log(m->avctx, AV_LOG_WARNING, " [%d]=%d",
+                           ci, merged_output_shift[ci]);
+                av_log(m->avctx, AV_LOG_WARNING, "\n");
+                /* Log bed vs spatial quant_step_size */
+                av_log(m->avctx, AV_LOG_WARNING,
+                       "  bed_quant_step:");
+                for (int ci = 0; ci <= (int)bed_s->max_matrix_channel; ci++)
+                    av_log(m->avctx, AV_LOG_WARNING, " [%d]=%d",
+                           ci, bed_s->quant_step_size[ci]);
+                av_log(m->avctx, AV_LOG_WARNING, "\n");
+                av_log(m->avctx, AV_LOG_WARNING,
+                       "  atmos_quant_step:");
+                for (int ci = 0; ci <= (int)s->max_matrix_channel; ci++)
+                    av_log(m->avctx, AV_LOG_WARNING, " [%d]=%d",
+                           ci, s->quant_step_size[ci]);
+                av_log(m->avctx, AV_LOG_WARNING, "\n");
+            }
+            /* Periodic peak logging every 500 blocks to catch loud passages */
+            if (atmos_dbg_periodic % 500 == 0) {
+                av_log(m->avctx, AV_LOG_WARNING,
+                       "ATMOS PEAKS[%d]:", atmos_dbg_periodic);
+                for (int ci = 0; ci < total_out2 && ci < MAX_CHANNELS; ci++) {
+                    int32_t peak = 0;
+                    for (unsigned int i = 0; i < s->blockpos; i++) {
+                        int32_t v = m->sample_buffer[i][ci];
+                        if (v < 0) v = -v;
+                        if (v > peak) peak = v;
+                    }
+                    av_log(m->avctx, AV_LOG_WARNING, " [%d]=%d", ci, peak);
+                }
+                av_log(m->avctx, AV_LOG_WARNING, "\n");
+            }
+        }
+
+        s->lossless_check_data = m->pack_output(s->lossless_check_data,
+                                                s->blockpos,
+                                                m->sample_buffer,
+                                                frame->data[0],
+                                                merged_ch_assign,
+                                                merged_output_shift,
+                                                effective_max_ch,
+                                                is32);
+    } else {
+        s->lossless_check_data = m->pack_output(s->lossless_check_data,
+                                                s->blockpos,
+                                                m->sample_buffer,
+                                                frame->data[0],
+                                                s->ch_assign,
+                                                s->output_shift,
+                                                effective_max_ch,
+                                                is32);
+    }
+
+    /* Update matrix encoding side data */
+    if (s->matrix_encoding != s->prev_matrix_encoding) {
+        if ((ret = ff_side_data_update_matrix_encoding(frame, s->matrix_encoding)) < 0)
+            return ret;
+
+        s->prev_matrix_encoding = s->matrix_encoding;
+    }
+
+    *got_frame_ptr = 1;
+
+    return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/*  Object metadata parser                                             */
+/*                                                                    */
+/*  Chain: AccessUnit → ExtraData → EvoFrame → EvoPayload(id=11)     */
+/*         → object metadata payload with object positions.           */
+/*                                                                    */
+/*  Position encoding (raw object metadata):                          */
+/*    X: 6 bits unsigned / 62.0 → [0,1]                              */
+/*    Y: 6 bits unsigned / 62.0 → [0,1]                              */
+/*    Z: 1 sign bit + 4 bits / 15.0 → [-1,+1]                        */
+/*                                                                    */
+/*  Output coordinates (DAMF):                                        */
+/*    x_out = (x_raw - 0.5) * 2.0     [-1,+1] left-right             */
+/*    y_out = (0.5 - y_raw) * 2.0     [-1,+1] front-back (inverted)  */
+/*    z_out = z_raw                    [-1,+1] below-above            */
+/* ------------------------------------------------------------------ */
+
+/** Read variable-length unsigned value matching truehdd get_variable_bits_max.
+ *  Each group: read n data bits, then 1 continuation bit.
+ *  If continuation=1: value = (value + 1) << n, read next group.
+ *  Repeat up to max_num_groups times. */
+static uint32_t oamd_get_variable(GetBitContext *gb, int n, int max_num_groups)
+{
+    uint32_t value = 0;
+    int num_group = 0;
+    int b_read_more = 1;
+
+    while (b_read_more && num_group < max_num_groups) {
+        uint32_t read_val = get_bits(gb, n);
+        value += read_val;
+        b_read_more = get_bits1(gb); /* continuation bit */
+        if (b_read_more) {
+            value = (value + 1) << n;
+            num_group++;
+        }
+    }
+    return value;
+}
+
+static const uint16_t oamd_ramp_lut[16] = {
+    32, 64, 128, 256, 320, 480, 1000, 1001,
+    1024, 1600, 1601, 1602, 1920, 2000, 2002, 2048
+};
+
+static const uint16_t oamd_smploffst_lut[4] = { 8, 16, 18, 24 };
+
+/** Parse object metadata payload bytes to extract object positions.
+ *  Follows truehdd oamd.rs structure exactly.
+ *  Returns 0 on success, <0 on error or if parsing fails gracefully. */
+static int parse_oamd_payload(AVCodecContext *avctx,
+                              const uint8_t *data, int size,
+                              uint32_t evo_sample_offset)
+{
+    GetBitContext gb;
+    int oamd_version, object_count, num_bed = 0, num_isf = 0, num_dynamic = 0;
+    int oa_element_count;
+
+    if (size < 4)
+        return -1;
+
+    init_get_bits(&gb, data, size * 8);
+
+    /* object metadata version */
+    oamd_version = get_bits(&gb, 2);
+    if (oamd_version == 3)
+        oamd_version += get_bits(&gb, 3);
+
+    /* Object count (truehdd: object_count_bits + 1) */
+    object_count = get_bits(&gb, 5);
+    if (object_count == 31)
+        object_count += get_bits(&gb, 7);
+    object_count += 1;
+    if (object_count > SPATIAL_EXT_MAX_OBJECTS)
+        object_count = SPATIAL_EXT_MAX_OBJECTS;
+
+    /* ProgramAssignment */
+    if (get_bits1(&gb)) {
+        /* b_dyn_object_only_program */
+        num_dynamic = object_count;
+        if (get_bits1(&gb)) { /* b_lfe_present */
+            num_bed = 1; /* LFE only */
+            num_dynamic--;
+        }
+    } else {
+        int content_desc = get_bits(&gb, 4);
+        /* Bit 0: bed objects */
+        if (content_desc & 1) {
+            skip_bits1(&gb); /* b_bed_chan_distribute */
+            int num_bed_instances = get_bits1(&gb) ? (get_bits(&gb, 3) + 2) : 1;
+            for (int bi = 0; bi < num_bed_instances; bi++) {
+                if (get_bits1(&gb)) {
+                    /* b_lfe_only — single LFE channel */
+                    num_bed += 1;
+                } else if (get_bits1(&gb)) {
+                    /* b_standard_chan_assign */
+                    int bed_assign = get_bits(&gb, 10);
+                    /* Count actual channels from STD_BED_LIST:
+                     * bits 0,3,4,5,6,7,8 = pairs (2 ch each)
+                     * bits 1,2,9 = single (1 ch each) */
+                    for (int b = 0; b < 10; b++) {
+                        if (bed_assign & (1 << b)) {
+                            if (b == 1 || b == 2 || b == 9)
+                                num_bed += 1;
+                            else
+                                num_bed += 2;
+                        }
+                    }
+                } else {
+                    /* Non-standard: 17-bit config, count set bits */
+                    int ns = get_bits(&gb, 17);
+                    for (int b = 0; b < 17; b++)
+                        if (ns & (1 << b))
+                            num_bed++;
+                }
+            }
+        }
+        /* Bit 1: ISF objects */
+        if (content_desc & 2) {
+            static const int isf_count_list[6] = {4, 8, 10, 14, 15, 30};
+            int isf_idx = get_bits(&gb, 3);
+            if (isf_idx < 6)
+                num_isf = isf_count_list[isf_idx];
+        }
+        /* Bit 2: dynamic objects */
+        if (content_desc & 4) {
+            int dyn_count = get_bits(&gb, 5);
+            if (dyn_count == 31)
+                dyn_count += get_bits(&gb, 7);
+            num_dynamic = dyn_count + 1;
+        }
+        /* Bit 3: reserved */
+        if (content_desc & 8) {
+            int res_sz = (get_bits(&gb, 4) + 1) << 3;
+            skip_bits(&gb, res_sz);
+        }
+    }
+
+    int beds_or_isf = num_bed + num_isf;
+
+    /* b_alternate_object_data_present */
+    int b_alt = get_bits1(&gb);
+
+    /* OA element count — truehdd does NOT add 1 */
+    oa_element_count = get_bits(&gb, 4);
+    if (oa_element_count == 15)
+        oa_element_count += get_bits(&gb, 5);
+
+    av_log(avctx, AV_LOG_DEBUG,
+           "OAMD: ver=%d obj=%d bed=%d dyn=%d elem=%d\n",
+           oamd_version, object_count, num_bed, num_dynamic,
+           oa_element_count);
+
+    /* Parse OA elements looking for ObjectElement (type 1) */
+    for (int elem = 0; elem < oa_element_count; elem++) {
+        if (get_bits_left(&gb) < 8)
+            break;
+
+        int elem_type_idx = get_bits(&gb, 4);
+        int elem_size_bits = (oamd_get_variable(&gb, 4, 4) + 1) << 3;
+
+        if (b_alt)
+            skip_bits(&gb, 4); /* alternate_object_data_id_idx */
+        skip_bits1(&gb); /* b_discard_unknown_element */
+
+        int elem_start = get_bits_count(&gb);
+
+        if (elem_type_idx == 1) {
+            /* ObjectElement — MDUpdateInfo */
+            int smpl_offset_code = get_bits(&gb, 2);
+            uint32_t sample_offset = 0;
+            if (smpl_offset_code == 1)
+                sample_offset = oamd_smploffst_lut[get_bits(&gb, 2)];
+            else if (smpl_offset_code == 2)
+                sample_offset = get_bits(&gb, 5);
+
+            int num_blocks = get_bits(&gb, 3) + 1;
+
+            /* BlockUpdateInfo for all blocks */
+            uint32_t ramp_duration = 0;
+            for (int blk = 0; blk < num_blocks; blk++) {
+                skip_bits(&gb, 6); /* block_offset_factor */
+                int rc = get_bits(&gb, 2);
+                uint32_t rd = 0;
+                if (rc == 1)      rd = 512;
+                else if (rc == 2) rd = 1536;
+                else if (rc == 3) {
+                    if (get_bits1(&gb))
+                        rd = oamd_ramp_lut[get_bits(&gb, 4)];
+                    else
+                        rd = get_bits(&gb, 11);
+                }
+                if (blk == 0) ramp_duration = rd;
+            }
+
+            /* b_reserved_data_not_present */
+            if (!get_bits1(&gb))
+                skip_bits(&gb, 5);
+
+            /* Parse ObjectInfoBlocks for all objects × all blocks.
+             * truehdd structure: for each object → for each block → ObjectInfoBlock.
+             * We capture block 0 data for position export. */
+            SpatialExtObjMeta oamd = {0};
+            oamd.num_objects = FFMIN(object_count, SPATIAL_EXT_MAX_OBJECTS);
+            oamd.num_bed_objects = num_bed;
+            oamd.num_dynamic_objects = num_dynamic;
+            oamd.sample_offset = sample_offset + evo_sample_offset;
+            oamd.ramp_duration = ramp_duration;
+
+            int8_t prev_gain[8] = {0}; /* per block_index, across objects */
+
+            for (int obj = 0; obj < oamd.num_objects; obj++) {
+              for (int blk = 0; blk < num_blocks; blk++) {
+                if (get_bits_left(&gb) < 2)
+                    goto oamd_export;
+
+                /* b_object_not_active */
+                int b_inactive = get_bits1(&gb);
+                if (blk == 0)
+                    oamd.objects[obj].active = !b_inactive;
+
+                /* object_basic_info_status_idx:
+                 *   inactive → 0
+                 *   block 0, active → 1 (implicit, no bits read)
+                 *   block >0, active → read 2 bits */
+                int basic_status;
+                if (b_inactive)
+                    basic_status = 0;
+                else if (blk == 0)
+                    basic_status = 1;
+                else
+                    basic_status = get_bits(&gb, 2);
+
+                /* ObjectBasicInfo:
+                 *   status 0: default (no bits)
+                 *   status 1: mask=3 hardcoded (gain+priority present)
+                 *   status 2: carry from previous (no bits)
+                 *   status 3: read 2-bit mask, selective update */
+                if (basic_status == 1 || basic_status == 3) {
+                    int basic_bits = (basic_status == 1) ? 3 : get_bits(&gb, 2);
+
+                    if (basic_bits & 1) { /* gain */
+                        int8_t prev_g = (obj > 0) ? prev_gain[blk] : 0;
+                        int gain_idx = get_bits(&gb, 2);
+                        int8_t gain = 0;
+                        if (gain_idx == 0)
+                            gain = 0;
+                        else if (gain_idx == 1)
+                            gain = -128;
+                        else if (gain_idx == 2) {
+                            int gv = get_bits(&gb, 6);
+                            gain = (gv <= 14) ?
+                                (int8_t)(15 - gv) : (int8_t)(14 - gv);
+                        } else {
+                            gain = prev_g;
+                        }
+                        prev_gain[blk] = gain;
+                        if (blk == 0)
+                            oamd.objects[obj].gain_db = gain;
+                    }
+                    if (basic_bits & 2) { /* priority */
+                        if (!get_bits1(&gb)) /* b_default_priority */
+                            skip_bits(&gb, 5);
+                    }
+                }
+                /* status 0, 2: no bits consumed */
+
+                /* object_render_info_status_idx:
+                 *   inactive → 0
+                 *   bed/ISF → 0
+                 *   dynamic, block 0 → 1 (implicit)
+                 *   dynamic, block >0 → read 2 bits */
+                int in_bed_or_isf = (obj < beds_or_isf);
+                int render_status;
+                if (b_inactive)
+                    render_status = 0;
+                else if (!in_bed_or_isf) {
+                    if (blk == 0)
+                        render_status = 1;
+                    else
+                        render_status = get_bits(&gb, 2);
+                } else {
+                    render_status = 0;
+                }
+
+                /* ObjectRenderInfo:
+                 *   status 0: default (no bits)
+                 *   status 1: all present (render_bits=15)
+                 *   status 2: carry from previous (no bits)
+                 *   status 3: read 4-bit mask, selective update */
+                if (render_status == 1 || render_status == 3) {
+                    int render_bits = (render_status == 1) ? 15
+                                                           : get_bits(&gb, 4);
+
+                    /* Bit 0: position */
+                    if (render_bits & 1) {
+                        int b_differential = (blk == 0) ? 0 : get_bits1(&gb);
+
+                        if (b_differential) {
+                            /* Differential: 3 signed bits each for x, y, z */
+                            int dx = get_bits(&gb, 3);
+                            int dy = get_bits(&gb, 3);
+                            int dz = get_bits(&gb, 3);
+                            /* Sign extend 3-bit values */
+                            if (dx >= 4) dx -= 8;
+                            if (dy >= 4) dy -= 8;
+                            if (dz >= 4) dz -= 8;
+                            (void)dx; (void)dy; (void)dz;
+                        } else {
+                            /* Absolute position */
+                            int x_raw = get_bits(&gb, 6);
+                            int y_raw = get_bits(&gb, 6);
+                            int z_sign = get_bits1(&gb) ? 1 : -1;
+                            int z_mag = get_bits(&gb, 4);
+
+                            if (blk == 0) {
+                                float x = (float)x_raw / 62.0f;
+                                float y = (float)y_raw / 62.0f;
+                                float z = (float)z_mag / 15.0f * z_sign;
+
+                                /* Transform to DAMF coordinates */
+                                oamd.objects[obj].x = (x - 0.5f) * 2.0f;
+                                oamd.objects[obj].y = (0.5f - y) * 2.0f;
+                                oamd.objects[obj].z = z;
+
+                                { static int raw_dbg = 0;
+                                  if (++raw_dbg <= 60)
+                                    av_log(avctx, AV_LOG_WARNING,
+                                      "  RAW obj=%d blk=%d xr=%d yr=%d zs=%d zm=%d -> DAMF(%.3f,%.3f,%.3f)\n",
+                                      obj, blk, x_raw, y_raw, z_sign, z_mag,
+                                      oamd.objects[obj].x, oamd.objects[obj].y, oamd.objects[obj].z);
+                                }
+                            }
+                        }
+
+                        /* b_object_distance_specified */
+                        if (get_bits1(&gb)) {
+                            if (!get_bits1(&gb)) /* b_at_infinity */
+                                skip_bits(&gb, 4);
+                        }
+                    }
+                    /* Bit 1: zone constraints */
+                    if (render_bits & 2) {
+                        skip_bits(&gb, 3);
+                        skip_bits1(&gb); /* b_enable_elevation */
+                    }
+                    /* Bit 2: size */
+                    if (render_bits & 4) {
+                        int sz = get_bits(&gb, 2);
+                        if (sz == 1) {
+                            if (blk == 0)
+                                oamd.objects[obj].size =
+                                    (float)get_bits(&gb, 5) / 31.0f;
+                            else
+                                skip_bits(&gb, 5);
+                        } else if (sz == 2) {
+                            if (blk == 0)
+                                oamd.objects[obj].size =
+                                    (float)get_bits(&gb, 5) / 31.0f;
+                            else
+                                skip_bits(&gb, 5);
+                            skip_bits(&gb, 5); /* depth */
+                            skip_bits(&gb, 5); /* height */
+                        }
+                    }
+                    /* Bit 3: screen reference */
+                    if (render_bits & 8) {
+                        if (get_bits1(&gb)) {
+                            skip_bits(&gb, 3); /* screen_factor */
+                            skip_bits(&gb, 2); /* depth_factor */
+                        }
+                    }
+                    /* b_object_snap */
+                    skip_bits1(&gb);
+                }
+                /* render_status 0, 2: no bits consumed */
+
+                /* b_additional_table_data_exists — read for ALL
+                 * objects+blocks including inactive (truehdd line 639) */
+                if (get_bits1(&gb)) {
+                    int addl_size = (get_bits(&gb, 4) + 1) << 3;
+                    if (addl_size <= get_bits_left(&gb))
+                        skip_bits(&gb, addl_size);
+                }
+              } /* end block loop */
+            } /* end object loop */
+oamd_export:
+
+            /* Export to global structure */
+            for (int obj = 0; obj < oamd.num_objects; obj++)
+                g_spatial_ext_objmeta.objects[obj] = oamd.objects[obj];
+            g_spatial_ext_objmeta.num_objects = oamd.num_objects;
+            g_spatial_ext_objmeta.num_bed_objects = oamd.num_bed_objects;
+            g_spatial_ext_objmeta.num_dynamic_objects = oamd.num_dynamic_objects;
+            g_spatial_ext_objmeta.sample_offset = oamd.sample_offset;
+            g_spatial_ext_objmeta.ramp_duration = oamd.ramp_duration;
+            atomic_store(&g_spatial_ext_objmeta.updated, 1);
+
+            { /* Debug: log ALL object positions every ~50 frames */
+                static int oamd_dbg_cnt = 0;
+                if (++oamd_dbg_cnt % 50 == 1) {
+                    av_log(avctx, AV_LOG_WARNING,
+                           "OAMD[%d]: nblk=%d obj=%d bed=%d isf=%d dyn=%d beds_or_isf=%d\n",
+                           oamd_dbg_cnt, num_blocks, oamd.num_objects,
+                           oamd.num_bed_objects, num_isf,
+                           oamd.num_dynamic_objects, beds_or_isf);
+                    for (int obj = 0; obj < oamd.num_objects; obj++)
+                        av_log(avctx, AV_LOG_WARNING,
+                               "  [%d] act=%d x=%+.3f y=%+.3f z=%+.3f g=%d sz=%.2f\n",
+                               obj, oamd.objects[obj].active,
+                               oamd.objects[obj].x, oamd.objects[obj].y,
+                               oamd.objects[obj].z, oamd.objects[obj].gain_db,
+                               oamd.objects[obj].size);
+                }
+            }
+
+            return 0;
+        }
+
+        /* Skip unknown element types using elem_size_bits */
+        int consumed = get_bits_count(&gb) - elem_start;
+        int skip = elem_size_bits - consumed;
+        if (skip > 0 && skip <= get_bits_left(&gb))
+            skip_bits(&gb, skip);
+    }
+
+    return -1;
+}
+
+/** Parse ExtraData and EVO frame after substreams to find object metadata.
+ *  buf points to the first byte after all substream data.
+ *  remaining is the number of bytes left in the access unit. */
+static void parse_extra_data_objmeta(AVCodecContext *avctx,
+                                  const uint8_t *buf, int remaining)
+{
+    GetBitContext gb;
+
+    if (remaining < 4)
+        return;
+
+    init_get_bits(&gb, buf, remaining * 8);
+
+    /* ExtraData header: 4-bit check + 12-bit length (in 16-bit words) */
+    skip_bits(&gb, 4); /* check_nibble */
+    int extra_len_words = get_bits(&gb, 12);
+    int extra_len_bytes = extra_len_words * 2;
+
+    if (extra_len_bytes < 2 || extra_len_bytes + 2 > remaining)
+        return;
+
+    /* EVO frame: 4-bit reserved + 12-bit byte length */
+    skip_bits(&gb, 4); /* evo_reserved */
+    int evo_byte_len = get_bits(&gb, 12);
+
+    if (evo_byte_len < 2 || evo_byte_len > extra_len_bytes)
+        return;
+
+    /* EVO frame content starts here */
+    /* evo_version: 2 bits (if 3, read more) */
+    int evo_ver = get_bits(&gb, 2);
+    if (evo_ver == 3)
+        evo_ver += oamd_get_variable(&gb, 2, 16);
+
+    /* key_id: 3 bits (if 7, read more) */
+    int key_id = get_bits(&gb, 3);
+    if (key_id == 7)
+        key_id += oamd_get_variable(&gb, 3, 10);
+    (void)evo_ver;
+    (void)key_id;
+
+    /* EVO payloads: loop until payload_id == 0 */
+    while (get_bits_left(&gb) >= 8) {
+        int payload_id = get_bits(&gb, 5);
+        if (payload_id == 0)
+            break; /* terminator */
+
+        /* EvoPayloadConfig (matches truehdd evolution.rs) */
+        uint32_t smploffst = 0;
+        int has_smploffst = 0;
+
+        /* smploffst */
+        if (get_bits1(&gb)) {
+            smploffst = oamd_get_variable(&gb, 11, 2);
+            has_smploffst = 1;
+        }
+        /* duration */
+        if (get_bits1(&gb))
+            oamd_get_variable(&gb, 11, 2); /* discard */
+        /* groupid */
+        if (get_bits1(&gb))
+            oamd_get_variable(&gb, 2, 16); /* discard */
+        /* codedcdata */
+        if (get_bits1(&gb))
+            skip_bits(&gb, 8); /* discard */
+        /* discard_unknown_payload (inverted flag) */
+        if (!get_bits1(&gb)) {
+            int payload_frame_aligned = 0;
+            if (!has_smploffst)
+                payload_frame_aligned = get_bits1(&gb);
+            if (payload_frame_aligned) {
+                skip_bits(&gb, 1); /* create_duplicate */
+                skip_bits(&gb, 1); /* remove_duplicate */
+            }
+            if (has_smploffst || payload_frame_aligned) {
+                skip_bits(&gb, 5); /* priority */
+                skip_bits(&gb, 2); /* proc_allowed */
+            }
+        }
+
+        /* evo_payload_size: number of bytes, then read each byte */
+        uint32_t payload_size = oamd_get_variable(&gb, 8, 4);
+
+        if (payload_id == 11 && payload_size > 0 &&
+            (int)payload_size * 8 <= get_bits_left(&gb)) {
+            /* Extract object metadata payload bytes from the bitstream */
+            uint8_t oamd_buf[512];
+            uint32_t copy_size = FFMIN(payload_size, sizeof(oamd_buf));
+            for (uint32_t i = 0; i < copy_size; i++)
+                oamd_buf[i] = get_bits(&gb, 8);
+            parse_oamd_payload(avctx, oamd_buf, copy_size, smploffst);
+            return; /* done after first object metadata */
+        }
+
+        /* Skip payload bytes */
+        if (payload_size * 8 > (unsigned)get_bits_left(&gb))
+            return;
+        skip_bits(&gb, payload_size * 8);
+    }
+}
+
+/** Read an access unit from the stream.
+ *  @return negative on error, 0 if not enough data is present in the input stream,
+ *  otherwise the number of bytes consumed. */
+
+static int read_access_unit(AVCodecContext *avctx, AVFrame *frame,
+                            int *got_frame_ptr, AVPacket *avpkt)
+{
+    const uint8_t *buf = avpkt->data;
+    int buf_size = avpkt->size;
+    MLPDecodeContext *m = avctx->priv_data;
+    GetBitContext gb;
+    unsigned int length, substr;
+    unsigned int substream_start;
+    unsigned int all_substreams_end = 0;
+    unsigned int header_size = 4;
+    unsigned int substr_header_size = 0;
+    uint8_t substream_parity_present[MAX_SUBSTREAMS];
+    uint16_t substream_data_len[MAX_SUBSTREAMS];
+    uint8_t parity_bits;
+    int ret;
+
+    if (buf_size < 4)
+        return AVERROR_INVALIDDATA;
+
+    /* Do NOT reset bed_blockpos here.  Keep the last valid bed_buffer so
+     * that if the bed substream fails to decode for one access unit the
+     * channel rearrangement (bed in 0-7, objects in 8-15) still works
+     * instead of falling back to the wrong order. bed_blockpos is
+     * overwritten whenever the bed substream decodes successfully. */
+
+    length = (AV_RB16(buf) & 0xfff) * 2;
+
+    if (length < 4 || length > buf_size)
+        return AVERROR_INVALIDDATA;
+
+    init_get_bits(&gb, (buf + 4), (length - 4) * 8);
+
+    m->is_major_sync_unit = 0;
+    if (show_bits_long(&gb, 31) == (0xf8726fba >> 1)) {
+        if (read_major_sync(m, &gb) < 0)
+            goto error;
+        m->is_major_sync_unit = 1;
+        header_size += m->major_sync_header_size;
+        frame->flags |= AV_FRAME_FLAG_KEY;
+    }
+
+    if (!m->params_valid) {
+        av_log(m->avctx, AV_LOG_WARNING,
+               "Stream parameters not seen; skipping frame.\n");
+        *got_frame_ptr = 0;
+        return length;
+    }
+
+    substream_start = 0;
+
+    for (substr = 0; substr < m->num_substreams; substr++) {
+        int extraword_present, checkdata_present, end, nonrestart_substr;
+
+        extraword_present = get_bits1(&gb);
+        nonrestart_substr = get_bits1(&gb);
+        checkdata_present = get_bits1(&gb);
+        skip_bits1(&gb);
+
+        end = get_bits(&gb, 12) * 2;
+
+        substr_header_size += 2;
+
+        if (extraword_present) {
+            if (m->avctx->codec_id == AV_CODEC_ID_MLP) {
+                av_log(m->avctx, AV_LOG_ERROR, "There must be no extraword for MLP.\n");
+                goto error;
+            }
+            skip_bits(&gb, 16);
+            substr_header_size += 2;
+        }
+
+        if (length < header_size + substr_header_size) {
+            av_log(m->avctx, AV_LOG_ERROR, "Insufficient data for headers\n");
+            goto error;
+        }
+
+        if (!(nonrestart_substr ^ m->is_major_sync_unit)) {
+            av_log(m->avctx, AV_LOG_ERROR, "Invalid nonrestart_substr.\n");
+            goto error;
+        }
+
+        if (end + header_size + substr_header_size > length) {
+            av_log(m->avctx, AV_LOG_ERROR,
+                   "Indicated length of substream %d data goes off end of "
+                   "packet.\n", substr);
+            end = length - header_size - substr_header_size;
+        }
+
+        if (end < substream_start) {
+            av_log(avctx, AV_LOG_ERROR,
+                   "Indicated end offset of substream %d data "
+                   "is smaller than calculated start offset.\n",
+                   substr);
+            goto error;
+        }
+
+        all_substreams_end = end;
+
+        if (substr > m->max_decoded_substream)
+            continue;
+
+        substream_parity_present[substr] = checkdata_present;
+        substream_data_len[substr] = end - substream_start;
+        substream_start = end;
+    }
+
+    parity_bits  = ff_mlp_calculate_parity(buf, 4);
+    parity_bits ^= ff_mlp_calculate_parity(buf + header_size, substr_header_size);
+
+    if ((((parity_bits >> 4) ^ parity_bits) & 0xF) != 0xF) {
+        av_log(avctx, AV_LOG_ERROR, "Parity check failed.\n");
+        goto error;
+    }
+
+    buf += header_size + substr_header_size;
+
+    for (substr = 0; substr <= m->max_decoded_substream; substr++) {
+        SubStream *s = &m->substream[substr];
+
+        init_get_bits(&gb, buf, substream_data_len[substr] * 8);
+
+        m->matrix_changed = 0;
+        memset(m->filter_changed, 0, sizeof(m->filter_changed));
+
+        s->blockpos = 0;
+        if (m->extract_objects && substr >= 3)
+            m->spatial_num_blocks = 0;
+        {
+        do {
+            if (get_bits1(&gb)) {
+                if (get_bits1(&gb)) {
+                    /* A restart header should be present. */
+                    if (read_restart_header(m, &gb, buf, substr) < 0)
+                        goto next_substr;
+                    s->restart_seen = 1;
+                }
+
+                if (!s->restart_seen)
+                    goto next_substr;
+                if (read_decoding_params(m, &gb, substr) < 0)
+                    goto next_substr;
+            }
+
+            if (!s->restart_seen)
+                goto next_substr;
+
+            if (((avctx->ch_layout.nb_channels == 6 &&
+                  ((m->substream_info >> 2) & 0x3) != 0x3) ||
+                 (avctx->ch_layout.nb_channels == 8 &&
+                  ((m->substream_info >> 4) & 0x7) != 0x7 &&
+                  ((m->substream_info >> 4) & 0x7) != 0x6 &&
+                  ((m->substream_info >> 4) & 0x7) != 0x3)) &&
+                substr > 0 && substr < m->max_decoded_substream &&
+                (s->min_channel <= m->substream[substr - 1].max_channel)) {
+                av_log(avctx, AV_LOG_DEBUG,
+                       "Previous substream(%d) channels overlaps current substream(%d) channels, skipping.\n",
+                       substr - 1, substr);
+                goto next_substr;
+            }
+
+            if (substr != m->max_decoded_substream &&
+                !(m->extract_objects && m->max_decoded_substream >= 3 &&
+                  substr == m->max_decoded_substream - 1) &&
+                ((s->coded_channels & m->substream[m->max_decoded_substream].coded_channels) != 0)) {
+                av_log(avctx, AV_LOG_DEBUG,
+                       "Current substream(%d) channels overlaps final substream(%d) channels, skipping.\n",
+                       substr, m->max_decoded_substream);
+                goto next_substr;
+            }
+
+            /* Save per-block spatial coefficients BEFORE read_block_data
+             * so each block's rematrix uses its own seed/delta. */
+            if (m->extract_objects && substr >= 3 &&
+                m->spatial_substream_type &&
+                m->spatial_num_blocks < MAX_SPATIAL_BLOCKS_PER_AU) {
+                int blk = m->spatial_num_blocks;
+                m->spatial_blk[blk].start = s->blockpos;
+                m->spatial_blk[blk].num_matrices = s->num_primitive_matrices;
+                memcpy(m->spatial_blk[blk].out_ch, s->matrix_out_ch,
+                       sizeof(m->spatial_blk[blk].out_ch));
+                memcpy(m->spatial_blk[blk].seed, s->matrix_coeff,
+                       sizeof(m->spatial_blk[blk].seed));
+                memcpy(m->spatial_blk[blk].delta, s->delta_matrix_coeff,
+                       sizeof(m->spatial_blk[blk].delta));
+            }
+
+            if ((ret = read_block_data(m, &gb, substr)) < 0) {
+                if (m->extract_objects && substr >= 3) {
+                    s->blockpos = 0;
+                    goto next_substr;
+                }
+                return ret;
+            }
+
+            /* Record block size and advance seed for next block. */
+            if (m->extract_objects && substr >= 3 &&
+                m->spatial_substream_type &&
+                m->spatial_num_blocks < MAX_SPATIAL_BLOCKS_PER_AU) {
+                int blk = m->spatial_num_blocks;
+                m->spatial_blk[blk].size = s->blockpos - m->spatial_blk[blk].start;
+                m->spatial_num_blocks++;
+                for (unsigned int mt = 0; mt < (unsigned)s->num_primitive_matrices; mt++)
+                    for (unsigned int c = 0; c <= s->max_matrix_channel; c++)
+                        s->matrix_coeff[mt][c] += s->delta_matrix_coeff[mt][c];
+            }
+
+            if (get_bits_count(&gb) >= substream_data_len[substr] * 8) {
+                if (m->extract_objects && substr >= 3) {
+                    s->blockpos = 0;
+                    goto next_substr;
+                }
+                goto substream_length_mismatch;
+            }
+
+        } while (!get_bits1(&gb));
+        } /* end block scope */
+
+        skip_bits(&gb, (-get_bits_count(&gb)) & 15);
+
+        if (substream_data_len[substr] * 8 - get_bits_count(&gb) >= 32) {
+            int shorten_by;
+
+            if (get_bits(&gb, 16) != 0xD234) {
+                if (m->extract_objects && substr >= 3) {
+                    s->blockpos = 0;
+                    goto next_substr;
+                }
+                return AVERROR_INVALIDDATA;
+            }
+
+            shorten_by = get_bits(&gb, 16);
+            if      (m->avctx->codec_id == AV_CODEC_ID_TRUEHD && shorten_by  & 0x2000)
+                s->blockpos -= FFMIN(shorten_by & 0x1FFF, s->blockpos);
+            else if (m->avctx->codec_id == AV_CODEC_ID_MLP    && shorten_by != 0xD234)
+                return AVERROR_INVALIDDATA;
+
+            av_log(m->avctx, AV_LOG_DEBUG, "End of stream indicated.\n");
+            s->end_of_stream = 1;
+        }
+
+        if (substream_parity_present[substr]) {
+            uint8_t parity, checksum;
+
+            if (substream_data_len[substr] * 8 - get_bits_count(&gb) != 16) {
+                if (m->extract_objects && substr >= 3) {
+                    s->blockpos = 0;
+                    goto next_substr;
+                }
+                goto substream_length_mismatch;
+            }
+
+            parity   = ff_mlp_calculate_parity(buf, substream_data_len[substr] - 2);
+            checksum = ff_mlp_checksum8       (buf, substream_data_len[substr] - 2);
+
+            if ((get_bits(&gb, 8) ^ parity) != 0xa9    )
+                av_log(m->avctx, AV_LOG_ERROR, "Substream %d parity check failed.\n", substr);
+            if ( get_bits(&gb, 8)           != checksum)
+                av_log(m->avctx, AV_LOG_ERROR, "Substream %d checksum failed.\n"    , substr);
+        }
+
+        if (substream_data_len[substr] * 8 != get_bits_count(&gb)) {
+            if (m->extract_objects && substr >= 3) {
+                s->blockpos = 0;
+                goto next_substr;
+            }
+            goto substream_length_mismatch;
+        }
+
+next_substr:
+        if (!s->restart_seen)
+            av_log(m->avctx, AV_LOG_ERROR,
+                   "No restart header present in substream %d.\n", substr);
+
+        /* Apply the bed substream's standard rematrix to get clean
+         * per-channel audio, then save to bed_buffer.  The rematrix
+         * reverses the decorrelation applied during encoding so that
+         * each output channel carries exactly one speaker's signal.
+         * We must do this HERE before the spatial substream decodes,
+         * because the spatial decode will overwrite sample_buffer and
+         * bypassed_lsbs. */
+        if (m->extract_objects && m->max_decoded_substream >= 3 &&
+            substr == m->max_decoded_substream - 1 &&
+            s->restart_seen && s->blockpos > 0) {
+            unsigned int bed_maxchan = s->max_matrix_channel;
+
+            /* Generate noise channels for the bed's rematrix */
+            if (!s->noise_type) {
+                generate_2_noise_channels(m, substr);
+                bed_maxchan += 2;
+                if (bed_maxchan >= MAX_CHANNELS)
+                    bed_maxchan = MAX_CHANNELS - 1;
+            } else {
+                fill_noise_buffer(m, substr);
+            }
+
+            /* Apply bed's standard rematrix (2.14 fixed-point) */
+            for (unsigned int bmat = 0; bmat < s->num_primitive_matrices; bmat++) {
+                unsigned int dest_ch = s->matrix_out_ch[bmat];
+                m->dsp.mlp_rematrix_channel(&m->sample_buffer[0][0],
+                                            s->matrix_coeff[bmat],
+                                            &m->bypassed_lsbs[0][bmat],
+                                            m->noise_buffer,
+                                            s->num_primitive_matrices - bmat,
+                                            dest_ch,
+                                            s->blockpos,
+                                            bed_maxchan,
+                                            s->matrix_noise_shift[bmat],
+                                            m->access_unit_size_pow2,
+                                            MSB_MASK(s->quant_step_size[dest_ch]));
+            }
+
+            m->bed_blockpos = s->blockpos;
+            m->bed_max_ch = s->max_matrix_channel;
+            memcpy(m->bed_buffer, m->sample_buffer,
+                   s->blockpos * sizeof(m->bed_buffer[0]));
+        }
+
+        buf += substream_data_len[substr];
+    }
+
+    /* Parse object metadata from ExtraData after all substreams (spatial only).
+     * ExtraData starts after ALL substream data (including undecoded ones).
+     * buf may only have been advanced through decoded substreams, so use
+     * all_substreams_end (from headers) to find the true start. */
+    if (m->avctx->profile == AV_PROFILE_TRUEHD_ATMOS) {
+        const uint8_t *data_start = avpkt->data + header_size + substr_header_size;
+        const uint8_t *extra_start = data_start + all_substreams_end;
+        const uint8_t *au_end = avpkt->data + length;
+        int extra_remaining = au_end - extra_start;
+        if (extra_remaining > 4)
+            parse_extra_data_objmeta(avctx, extra_start, extra_remaining);
+    }
+
+    /* When extract_objects is enabled, fall back to a lower substream if
+     * substream 3 failed to decode (restart not seen, or parse error
+     * resulting in blockpos==0). Always output 16 channels for stability.
+     *
+     * If bed_buffer is available and the spatial substream has seen a
+     * restart header, prefer restoring blockpos and keeping the spatial
+     * path.  output_data's spatial branch will inject bed_buffer into
+     * sample_buffer (overwriting the corrupted partial-decode data),
+     * run the rematrix, then re-inject bed audio.  This ensures the
+     * output format (ch_assign, output_shift, channel count) stays
+     * identical to normal spatial frames, avoiding audible discontinuities
+     * from format switching. */
+    {
+        unsigned int output_substr = m->max_decoded_substream;
+        if (m->extract_objects && output_substr >= 3 &&
+            (!m->substream[output_substr].restart_seen ||
+             !m->substream[output_substr].blockpos)) {
+            if (m->bed_blockpos > 0 &&
+                m->substream[output_substr].restart_seen) {
+                /* spatial parse error (blockpos==0) but bed_buffer valid.
+                 * Restore blockpos so the spatial output path runs normally
+                 * with bed audio injection providing clean sample data. */
+                m->substream[output_substr].blockpos = m->bed_blockpos;
+                av_log(m->avctx, AV_LOG_WARNING,
+                       "spatial substream error, using bed buffer "
+                       "(blockpos restored to %u)\n", m->bed_blockpos);
+            } else {
+                output_substr = FFMIN(m->max_decoded_substream - 1, 2);
+                while (output_substr > 0 &&
+                       !m->substream[output_substr].restart_seen)
+                    output_substr--;
+            }
+        }
+        if ((ret = output_data(m, output_substr, frame, got_frame_ptr)) < 0)
+            return ret;
+    }
+
+    for (substr = 0; substr <= m->max_decoded_substream; substr++){
+        SubStream *s = &m->substream[substr];
+
+        if (s->end_of_stream) {
+            s->lossless_check_data = 0xffffffff;
+            s->end_of_stream = 0;
+            m->params_valid = 0;
+        }
+    }
+
+    return length;
+
+substream_length_mismatch:
+    av_log(m->avctx, AV_LOG_ERROR, "substream %d length mismatch\n", substr);
+    return AVERROR_INVALIDDATA;
+
+error:
+    m->params_valid = 0;
+    return AVERROR_INVALIDDATA;
+}
+
+static void mlp_decode_flush(AVCodecContext *avctx)
+{
+    MLPDecodeContext *m = avctx->priv_data;
+
+    m->params_valid = 0;
+    for (int substr = 0; substr <= m->max_decoded_substream; substr++){
+        SubStream *s = &m->substream[substr];
+
+        s->lossless_check_data = 0xffffffff;
+        s->prev_matrix_encoding = 0;
+    }
+}
+
+#define OFFSET(x) offsetof(MLPDecodeContext, x)
+#define FLAGS (AV_OPT_FLAG_DECODING_PARAM | AV_OPT_FLAG_AUDIO_PARAM)
+static const AVOption options[] = {
+    { "downmix", "Request a specific channel layout from the decoder", OFFSET(downmix_layout),
+        AV_OPT_TYPE_CHLAYOUT, {.str = NULL}, .flags = FLAGS },
+    { "extract_objects", "Extract spatial object audio from 4th substream",
+        OFFSET(extract_objects), AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, FLAGS },
+    { NULL },
+};
+
+static const AVClass mlp_decoder_class = {
+    .class_name = "MLP decoder",
+    .item_name  = av_default_item_name,
+    .option     = options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+static const AVClass truehd_decoder_class = {
+    .class_name = "TrueHD decoder",
+    .item_name  = av_default_item_name,
+    .option     = options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+#if CONFIG_MLP_DECODER
+const FFCodec ff_mlp_decoder = {
+    .p.name         = "mlp",
+    CODEC_LONG_NAME("MLP (Meridian Lossless Packing)"),
+    .p.type         = AVMEDIA_TYPE_AUDIO,
+    .p.id           = AV_CODEC_ID_MLP,
+    .priv_data_size = sizeof(MLPDecodeContext),
+    .p.priv_class   = &mlp_decoder_class,
+    .init           = mlp_decode_init,
+    FF_CODEC_DECODE_CB(read_access_unit),
+    .flush          = mlp_decode_flush,
+    .p.capabilities = AV_CODEC_CAP_DR1 | AV_CODEC_CAP_CHANNEL_CONF,
+};
+#endif
+#if CONFIG_TRUEHD_DECODER
+const FFCodec ff_truehd_decoder = {
+    .p.name         = "truehd",
+    CODEC_LONG_NAME("TrueHD"),
+    .p.type         = AVMEDIA_TYPE_AUDIO,
+    .p.id           = AV_CODEC_ID_TRUEHD,
+    .priv_data_size = sizeof(MLPDecodeContext),
+    .p.priv_class   = &truehd_decoder_class,
+    .init           = mlp_decode_init,
+    FF_CODEC_DECODE_CB(read_access_unit),
+    .flush          = mlp_decode_flush,
+    .p.capabilities = AV_CODEC_CAP_DR1 | AV_CODEC_CAP_CHANNEL_CONF,
+    .p.profiles     = NULL_IF_CONFIG_SMALL(ff_truehd_profiles),
+};
+#endif /* CONFIG_TRUEHD_DECODER */
