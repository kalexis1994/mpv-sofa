+/* Parse full object metadata payload and write to g_spatial_ext_objmeta */
+static int eac3_parse_objmeta(const uint8_t *payload, int payload_size) {
+    EmdfBitReader br;
+    emdf_br_init(&br, payload, payload_size);
+
+    uint32_t version = emdf_br_read(&br, 2);
+    if (version == 3) version += emdf_br_read(&br, 3);
+
+    uint32_t obj_bits = emdf_br_read(&br, 5);
+    if (obj_bits == 0x1F) obj_bits += emdf_br_read(&br, 7);
+    int object_count = obj_bits + 1;
+    if (object_count > SPATIAL_EXT_MAX_OBJECTS) object_count = SPATIAL_EXT_MAX_OBJECTS;
+
+    int b_dyn_only = 0, b_lfe = 0;
+    objmeta_parse_program_assignment(&br, &b_dyn_only, &b_lfe);
+
+    int b_alt = emdf_br_read(&br, 1);
+    uint32_t elem_bits = emdf_br_read(&br, 4);
+    if (elem_bits == 0xF) elem_bits += emdf_br_read(&br, 5);
+
+    /* Temporary object array (DD+ object metadata coords [0,1]) */
+    SpatialExtObjectPos objects[SPATIAL_EXT_MAX_OBJECTS];
+    memset(objects, 0, sizeof(objects));
+
+    for (uint32_t e = 0; e < elem_bits; e++) {
+        uint32_t elem_id = emdf_br_read(&br, 4);
+        uint32_t elem_size = emdf_variable_bits_max(&br, 4, 4);
+        if (b_alt) emdf_br_read(&br, 4);
+        emdf_br_read(&br, 1); /* discard */
+
+        int body_start = br.bit_pos;
+        int body_end = body_start + elem_size * 8;
+
+        if (elem_id == 1 && emdf_br_left(&br) > 20) {
+            /* object_element: parse md_update_info */
+            uint32_t soc = emdf_br_read(&br, 2);
+            if (soc == 1) emdf_br_read(&br, 2);
+            else if (soc == 2) emdf_br_read(&br, 5);
+
+            uint32_t num_blocks = emdf_br_read(&br, 3) + 1;
+            for (uint32_t blk = 0; blk < num_blocks; blk++) {
+                emdf_br_read(&br, 6); /* block_offset_factor */
+                uint32_t rdc = emdf_br_read(&br, 2);
+                if (rdc == 3) {
+                    if (emdf_br_read(&br, 1)) emdf_br_read(&br, 4);
+                    else emdf_br_read(&br, 11);
+                }
+            }
+
+            if (!emdf_br_read(&br, 1)) emdf_br_read(&br, 5); /* reserved */
+
+            /* Parse each object's blocks */
+            for (int j = 0; j < object_count; j++) {
+                for (uint32_t blk = 0; blk < num_blocks; blk++) {
+                    if (emdf_br_left(&br) < 3) goto done;
+                    objmeta_parse_info_block(&br, &objects[j], blk);
+                }
+            }
+        } else {
+            br.bit_pos = body_end;
+        }
+
+        if (br.bit_pos < body_end) br.bit_pos = body_end;
+    }
+
+done:
+    /* Convert DD+ object metadata [0,1] to DAMF [-1,+1] and write to global */
+    for (int j = 0; j < object_count; j++) {
+        g_spatial_ext_objmeta.objects[j].x      = objects[j].x * 2.0f - 1.0f;
+        g_spatial_ext_objmeta.objects[j].y      = objects[j].y * 2.0f - 1.0f;
+        g_spatial_ext_objmeta.objects[j].z      = objects[j].z;
+        g_spatial_ext_objmeta.objects[j].size    = objects[j].size;
+        g_spatial_ext_objmeta.objects[j].gain_db = objects[j].gain_db;
+        g_spatial_ext_objmeta.objects[j].active  = objects[j].active;
+    }
+    g_spatial_ext_objmeta.num_objects = object_count;
+    g_spatial_ext_objmeta.num_bed_objects = 0;
+    g_spatial_ext_objmeta.num_dynamic_objects = object_count;
+    atomic_store(&g_spatial_ext_objmeta.updated, 1);
+
+    /* Debug: log first few object metadata extractions to file */
+    {
+        static int eac3_objmeta_log_count = 0;
+        if (eac3_objmeta_log_count < 10) {
+            FILE *dbg = fopen("eac3_objmeta_debug.txt", "a");
+            if (dbg) {
+                fprintf(dbg, "EAC3-OBJMETA[%d]: %d objects\n",
+                        eac3_objmeta_log_count, object_count);
+                for (int j = 0; j < object_count && j < 16; j++) {
+                    fprintf(dbg, "  obj[%d] act=%d x=%+.3f y=%+.3f z=%+.3f g=%d\n",
+                            j, g_spatial_ext_objmeta.objects[j].active,
+                            g_spatial_ext_objmeta.objects[j].x,
+                            g_spatial_ext_objmeta.objects[j].y,
+                            g_spatial_ext_objmeta.objects[j].z,
+                            g_spatial_ext_objmeta.objects[j].gain_db);
+                }
+                fclose(dbg);
+            }
+            eac3_objmeta_log_count++;
+        }
+    }
+
+    return 0;
+}
