+/* Search for EMDF syncword 0x5838 at bit granularity and extract object metadata + object coding */
+static void eac3_extract_emdf_objmeta(const uint8_t *frame, int frame_size) {
+    /* Search for 0x5838 at every bit position */
+    int search_end = frame_size * 8;
+
+    for (int bit = 32; bit <= search_end - 48; bit++) {
+        int byte0 = bit >> 3;
+        int shift = bit & 7;
+        if (byte0 + 2 >= frame_size) break;
+
+        uint32_t window;
+        if (shift == 0)
+            window = ((uint32_t)frame[byte0] << 8) | frame[byte0 + 1];
+        else
+            window = (((uint32_t)frame[byte0] << (8 + shift)) |
+                      ((uint32_t)frame[byte0 + 1] << shift) |
+                      ((uint32_t)frame[byte0 + 2] >> (8 - shift))) & 0xFFFF;
+
+        if (window != 0x5838)
+            continue;
+
+        /* Found potential EMDF sync - read container length */
+        EmdfBitReader br;
+        emdf_br_init(&br, frame, frame_size);
+        br.bit_pos = bit + 16; /* skip syncword */
+        if (emdf_br_left(&br) < 16) break;
+
+        uint32_t emdf_len = emdf_br_read(&br, 16);
+        int body_start = br.bit_pos;
+        int body_end = body_start + emdf_len * 8;
+
+        /* Sanity check */
+        if (emdf_len == 0 || emdf_len >= (uint32_t)frame_size ||
+            body_end > frame_size * 8)
+            continue; /* false positive, try next bit */
+
+        /* Parse EMDF container body */
+        uint32_t version = emdf_br_read(&br, 2);
+        if (version == 3) version += emdf_variable_bits(&br, 2);
+        uint32_t key_id = emdf_br_read(&br, 3);
+        if (key_id == 7) key_id += emdf_variable_bits(&br, 3);
+
+        /* Payload loop — extract object metadata (id=11) and object coding (id=14) */
+        while (br.bit_pos < body_end - 16) {
+            uint32_t pid = emdf_br_read(&br, 5);
+            if (pid == 0) break; /* terminator */
+            if (pid == 0x1F) pid += emdf_variable_bits(&br, 5);
+
+            emdf_parse_payload_config(&br);
+            uint32_t psize = emdf_variable_bits(&br, 8);
+
+            if (psize == 0 || psize > 4096 || emdf_br_left(&br) < (int)psize * 8)
+                break;
+
+            if (pid == 11 || pid == 14) {
+                /* Extract payload bytes (object metadata=11, object coding=14) */
+                uint8_t pbuf[4096];
+                if (psize <= sizeof(pbuf)) {
+                    for (uint32_t j = 0; j < psize; j++)
+                        pbuf[j] = (uint8_t)emdf_br_read(&br, 8);
+                    if (pid == 11)
+                        eac3_parse_objmeta(pbuf, psize);
+                    else if (pid == 14)
+                        eac3_parse_objcoding(pbuf, psize);
+                } else {
+                    emdf_br_skip(&br, psize * 8);
+                }
+            } else {
+                emdf_br_skip(&br, psize * 8);
+            }
+        }
+        return; /* done with this frame */
+    }
+}
