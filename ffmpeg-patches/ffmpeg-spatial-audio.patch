+/** Read variable-length unsigned value matching truehdd get_variable_bits_max.
+ *  Each group: read n data bits, then 1 continuation bit.
+ *  If continuation=1: value = (value + 1) << n, read next group.
+ *  Repeat up to max_num_groups times. */
+static uint32_t oamd_get_variable(GetBitContext *gb, int n, int max_num_groups)
+{
+    uint32_t value = 0;
+    int num_group = 0;
+    int b_read_more = 1;
+
+    while (b_read_more && num_group < max_num_groups) {
+        uint32_t read_val = get_bits(gb, n);
+        value += read_val;
+        b_read_more = get_bits1(gb); /* continuation bit */
+        if (b_read_more) {
+            value = (value + 1) << n;
+            num_group++;
+        }
+    }
+    return value;
+}
