+ *  If continuation=1: value = (value + 1) << n, read next group.
+ *  Repeat up to max_num_groups times. */
+static uint32_t oamd_get_variable(GetBitContext *gb, int n, int max_num_groups)
+{
+    uint32_t value = 0;
+    int num_group = 0;
+    int b_read_more = 1;
+
+    while (b_read_more && num_group < max_num_groups) {
+        uint32_t read_val = get_bits(gb, n);
+        value += read_val;
+        b_read_more = get_bits1(gb); /* continuation bit */
+        if (b_read_more) {
+            value = (value + 1) << n;
+            num_group++;
+        }
+    }
+    return value;
+}
+
+static const uint16_t oamd_ramp_lut[16] = {
+    32, 64, 128, 256, 320, 480, 1000, 1001,
+    1024, 1600, 1601, 1602, 1920, 2000, 2002, 2048
+};
+
+static const uint16_t oamd_smploffst_lut[4] = { 8, 16, 18, 24 };
+
+/** Parse object metadata payload bytes to extract object positions.
+ *  Follows truehdd oamd.rs structure exactly.
+ *  Returns 0 on success, <0 on error or if parsing fails gracefully. */
+static int parse_oamd_payload(AVCodecContext *avctx,
+                              const uint8_t *data, int size,
+                              uint32_t evo_sample_offset)
+{
+    GetBitContext gb;
+    int oamd_version, object_count, num_bed = 0, num_isf = 0, num_dynamic = 0;
+    int oa_element_count;
+
+    if (size < 4)
+        return -1;
+
+    init_get_bits(&gb, data, size * 8);
+
+    /* object metadata version */
+    oamd_version = get_bits(&gb, 2);
+    if (oamd_version == 3)
+        oamd_version += get_bits(&gb, 3);
+
+    /* Object count (truehdd: object_count_bits + 1) */
+    object_count = get_bits(&gb, 5);
+    if (object_count == 31)
+        object_count += get_bits(&gb, 7);
+    object_count += 1;
+    if (object_count > SPATIAL_EXT_MAX_OBJECTS)
+        object_count = SPATIAL_EXT_MAX_OBJECTS;
+
+    /* ProgramAssignment */
+    if (get_bits1(&gb)) {
+        /* b_dyn_object_only_program */
+        num_dynamic = object_count;
+        if (get_bits1(&gb)) { /* b_lfe_present */
+            num_bed = 1; /* LFE only */
+            num_dynamic--;
+        }
+    } else {
+        int content_desc = get_bits(&gb, 4);
+        /* Bit 0: bed objects */
+        if (content_desc & 1) {
+            skip_bits1(&gb); /* b_bed_chan_distribute */
+            int num_bed_instances = get_bits1(&gb) ? (get_bits(&gb, 3) + 2) : 1;
+            for (int bi = 0; bi < num_bed_instances; bi++) {
+                if (get_bits1(&gb)) {
+                    /* b_lfe_only — single LFE channel */
+                    num_bed += 1;
+                } else if (get_bits1(&gb)) {
+                    /* b_standard_chan_assign */
+                    int bed_assign = get_bits(&gb, 10);
+                    /* Count actual channels from STD_BED_LIST:
+                     * bits 0,3,4,5,6,7,8 = pairs (2 ch each)
+                     * bits 1,2,9 = single (1 ch each) */
+                    for (int b = 0; b < 10; b++) {
+                        if (bed_assign & (1 << b)) {
+                            if (b == 1 || b == 2 || b == 9)
+                                num_bed += 1;
+                            else
+                                num_bed += 2;
+                        }
+                    }
+                } else {
+                    /* Non-standard: 17-bit config, count set bits */
+                    int ns = get_bits(&gb, 17);
+                    for (int b = 0; b < 17; b++)
+                        if (ns & (1 << b))
+                            num_bed++;
+                }
+            }
+        }
+        /* Bit 1: ISF objects */
+        if (content_desc & 2) {
+            static const int isf_count_list[6] = {4, 8, 10, 14, 15, 30};
+            int isf_idx = get_bits(&gb, 3);
+            if (isf_idx < 6)
+                num_isf = isf_count_list[isf_idx];
+        }
+        /* Bit 2: dynamic objects */
+        if (content_desc & 4) {
+            int dyn_count = get_bits(&gb, 5);
+            if (dyn_count == 31)
+                dyn_count += get_bits(&gb, 7);
+            num_dynamic = dyn_count + 1;
+        }
+        /* Bit 3: reserved */
+        if (content_desc & 8) {
+            int res_sz = (get_bits(&gb, 4) + 1) << 3;
+            skip_bits(&gb, res_sz);
+        }
+    }
+
+    int beds_or_isf = num_bed + num_isf;
+
+    /* b_alternate_object_data_present */
+    int b_alt = get_bits1(&gb);
+
+    /* OA element count — truehdd does NOT add 1 */
+    oa_element_count = get_bits(&gb, 4);
+    if (oa_element_count == 15)
+        oa_element_count += get_bits(&gb, 5);
+
+    av_log(avctx, AV_LOG_DEBUG,
+           "OAMD: ver=%d obj=%d bed=%d dyn=%d elem=%d\n",
+           oamd_version, object_count, num_bed, num_dynamic,
+           oa_element_count);
+
+    /* Parse OA elements looking for ObjectElement (type 1) */
+    for (int elem = 0; elem < oa_element_count; elem++) {
+        if (get_bits_left(&gb) < 8)
+            break;
+
+        int elem_type_idx = get_bits(&gb, 4);
+        int elem_size_bits = (oamd_get_variable(&gb, 4, 4) + 1) << 3;
+
+        if (b_alt)
+            skip_bits(&gb, 4); /* alternate_object_data_id_idx */
+        skip_bits1(&gb); /* b_discard_unknown_element */
+
+        int elem_start = get_bits_count(&gb);
+
+        if (elem_type_idx == 1) {
+            /* ObjectElement — MDUpdateInfo */
+            int smpl_offset_code = get_bits(&gb, 2);
+            uint32_t sample_offset = 0;
+            if (smpl_offset_code == 1)
+                sample_offset = oamd_smploffst_lut[get_bits(&gb, 2)];
+            else if (smpl_offset_code == 2)
+                sample_offset = get_bits(&gb, 5);
+
+            int num_blocks = get_bits(&gb, 3) + 1;
+
+            /* BlockUpdateInfo for all blocks */
+            uint32_t ramp_duration = 0;
+            for (int blk = 0; blk < num_blocks; blk++) {
+                skip_bits(&gb, 6); /* block_offset_factor */
+                int rc = get_bits(&gb, 2);
+                uint32_t rd = 0;
+                if (rc == 1)      rd = 512;
+                else if (rc == 2) rd = 1536;
+                else if (rc == 3) {
+                    if (get_bits1(&gb))
+                        rd = oamd_ramp_lut[get_bits(&gb, 4)];
+                    else
+                        rd = get_bits(&gb, 11);
+                }
+                if (blk == 0) ramp_duration = rd;
+            }
+
+            /* b_reserved_data_not_present */
+            if (!get_bits1(&gb))
+                skip_bits(&gb, 5);
+
+            /* Parse ObjectInfoBlocks for all objects × all blocks.
+             * truehdd structure: for each object → for each block → ObjectInfoBlock.
+             * We capture block 0 data for position export. */
+            SpatialExtObjMeta oamd = {0};
+            oamd.num_objects = FFMIN(object_count, SPATIAL_EXT_MAX_OBJECTS);
+            oamd.num_bed_objects = num_bed;
+            oamd.num_dynamic_objects = num_dynamic;
+            oamd.sample_offset = sample_offset + evo_sample_offset;
+            oamd.ramp_duration = ramp_duration;
+
+            int8_t prev_gain[8] = {0}; /* per block_index, across objects */
+            float cur_x[SPATIAL_EXT_MAX_OBJECTS];
+            float cur_y[SPATIAL_EXT_MAX_OBJECTS];
+            float cur_z[SPATIAL_EXT_MAX_OBJECTS];
+            int8_t cur_gain[SPATIAL_EXT_MAX_OBJECTS];
+
+            for (int obj = 0; obj < oamd.num_objects; obj++) {
+                cur_x[obj] = 0.5f;
+                cur_y[obj] = 0.5f;
+                cur_z[obj] = 0.0f;
+                cur_gain[obj] = -128;
+                oamd.objects[obj].gain_db = -128;
+            }
+
+            for (int obj = 0; obj < oamd.num_objects; obj++) {
+              for (int blk = 0; blk < num_blocks; blk++) {
+                if (get_bits_left(&gb) < 2)
+                    goto oamd_export;
+
+                /* b_object_not_active */
+                int b_inactive = get_bits1(&gb);
+                oamd.objects[obj].active = !b_inactive;
+
+                /* object_basic_info_status_idx:
+                 *   inactive → 0
+                 *   block 0, active → 1 (implicit, no bits read)
+                 *   block >0, active → read 2 bits */
+                int basic_status;
+                if (b_inactive)
+                    basic_status = 0;
+                else if (blk == 0)
+                    basic_status = 1;
+                else
+                    basic_status = get_bits(&gb, 2);
+
+                /* ObjectBasicInfo:
+                 *   status 0: default (no bits)
+                 *   status 1: mask=3 hardcoded (gain+priority present)
+                 *   status 2: carry from previous (no bits)
+                 *   status 3: read 2-bit mask, selective update */
+                if (basic_status == 1 || basic_status == 3) {
+                    int basic_bits = (basic_status == 1) ? 3 : get_bits(&gb, 2);
+
+                    if (basic_bits & 1) { /* gain */
+                        int8_t prev_g = (obj > 0) ? prev_gain[blk] : 0;
+                        int gain_idx = get_bits(&gb, 2);
+                        int8_t gain = 0;
+                        if (gain_idx == 0)
+                            gain = 0;
+                        else if (gain_idx == 1)
+                            gain = -128;
+                        else if (gain_idx == 2) {
+                            int gv = get_bits(&gb, 6);
+                            gain = (gv <= 14) ?
+                                (int8_t)(15 - gv) : (int8_t)(14 - gv);
+                        } else {
+                            gain = prev_g;
+                        }
+                        prev_gain[blk] = gain;
+                        cur_gain[obj] = gain;
+                    }
+                    if (basic_bits & 2) { /* priority */
+                        if (!get_bits1(&gb)) /* b_default_priority */
+                            skip_bits(&gb, 5);
+                    }
+                }
+                /* status 0, 2: no bits consumed */
+
+                oamd.objects[obj].gain_db = cur_gain[obj];
+
+                /* object_render_info_status_idx:
+                 *   inactive → 0
+                 *   bed/ISF → 0
+                 *   dynamic, block 0 → 1 (implicit)
+                 *   dynamic, block >0 → read 2 bits */
+                int in_bed_or_isf = (obj < beds_or_isf);
+                int render_status;
+                if (b_inactive)
+                    render_status = 0;
+                else if (!in_bed_or_isf) {
+                    if (blk == 0)
+                        render_status = 1;
+                    else
+                        render_status = get_bits(&gb, 2);
+                } else {
+                    render_status = 0;
+                }
+
+                /* ObjectRenderInfo:
+                 *   status 0: default (no bits)
+                 *   status 1: all present (render_bits=15)
+                 *   status 2: carry from previous (no bits)
+                 *   status 3: read 4-bit mask, selective update */
+                if (render_status == 1 || render_status == 3) {
+                    int render_bits = (render_status == 1) ? 15
+                                                           : get_bits(&gb, 4);
+
+                    /* Bit 0: position */
+                    if (render_bits & 1) {
+                        int b_differential = (blk == 0) ? 0 : get_bits1(&gb);
+
+                        if (b_differential) {
+                            /* Differential: 3 signed bits each for x, y, z */
+                            int dx = get_bits(&gb, 3);
+                            int dy = get_bits(&gb, 3);
+                            int dz = get_bits(&gb, 3);
+                            /* Sign extend 3-bit values */
+                            if (dx >= 4) dx -= 8;
+                            if (dy >= 4) dy -= 8;
+                            if (dz >= 4) dz -= 8;
+
+                            cur_x[obj] += (float)dx / 62.0f;
+                            cur_y[obj] += (float)dy / 62.0f;
+                            cur_z[obj] += (float)dz / 15.0f;
+                            if (cur_x[obj] < 0.0f) cur_x[obj] = 0.0f;
+                            if (cur_x[obj] > 1.0f) cur_x[obj] = 1.0f;
+                            if (cur_y[obj] < 0.0f) cur_y[obj] = 0.0f;
+                            if (cur_y[obj] > 1.0f) cur_y[obj] = 1.0f;
+                            if (cur_z[obj] < -1.0f) cur_z[obj] = -1.0f;
+                            if (cur_z[obj] > 1.0f) cur_z[obj] = 1.0f;
+                        } else {
+                            /* Absolute position */
+                            int x_raw = get_bits(&gb, 6);
+                            int y_raw = get_bits(&gb, 6);
+                            int z_sign = get_bits1(&gb) ? 1 : -1;
+                            int z_mag = get_bits(&gb, 4);
+
+                            cur_x[obj] = (float)x_raw / 62.0f;
+                            cur_y[obj] = (float)y_raw / 62.0f;
+                            cur_z[obj] = (float)z_mag / 15.0f * z_sign;
+
+                            { static int raw_dbg = 0;
+                              if (++raw_dbg <= 60)
+                                av_log(avctx, AV_LOG_DEBUG,
+                                  "  RAW obj=%d blk=%d xr=%d yr=%d zs=%d zm=%d -> DAMF(%.3f,%.3f,%.3f)\n",
+                                  obj, blk, x_raw, y_raw, z_sign, z_mag,
+                                  (cur_x[obj] - 0.5f) * 2.0f,
+                                  (0.5f - cur_y[obj]) * 2.0f,
+                                  cur_z[obj]);
+                            }
+                        }
+
+                        /* b_object_distance_specified */
+                        if (get_bits1(&gb)) {
+                            if (!get_bits1(&gb)) /* b_at_infinity */
+                                skip_bits(&gb, 4);
+                        }
+                    }
+                    /* Bit 1: zone constraints */
+                    if (render_bits & 2) {
+                        skip_bits(&gb, 3);
+                        skip_bits1(&gb); /* b_enable_elevation */
+                    }
+                    /* Bit 2: size */
+                    if (render_bits & 4) {
+                        int sz = get_bits(&gb, 2);
+                        if (sz == 1) {
+                            oamd.objects[obj].size =
+                                (float)get_bits(&gb, 5) / 31.0f;
+                        } else if (sz == 2) {
+                            oamd.objects[obj].size =
+                                (float)get_bits(&gb, 5) / 31.0f;
+                            skip_bits(&gb, 5); /* depth */
+                            skip_bits(&gb, 5); /* height */
+                        }
+                    }
+                    /* Bit 3: screen reference */
+                    if (render_bits & 8) {
+                        if (get_bits1(&gb)) {
+                            skip_bits(&gb, 3); /* screen_factor */
+                            skip_bits(&gb, 2); /* depth_factor */
+                        }
+                    }
+                    /* b_object_snap */
+                    skip_bits1(&gb);
+                }
+                /* render_status 0, 2: no bits consumed */
+
+                /* Keep latest parsed render state (including differential
+                 * updates in blocks >0) so object motion is not flattened to
+                 * block 0 only. */
+                oamd.objects[obj].x = (cur_x[obj] - 0.5f) * 2.0f;
+                oamd.objects[obj].y = (0.5f - cur_y[obj]) * 2.0f;
+                oamd.objects[obj].z = cur_z[obj];
+
+                /* b_additional_table_data_exists — read for ALL
+                 * objects+blocks including inactive (truehdd line 639) */
+                if (get_bits1(&gb)) {
+                    int addl_size = (get_bits(&gb, 4) + 1) << 3;
+                    if (addl_size <= get_bits_left(&gb))
+                        skip_bits(&gb, addl_size);
+                }
+              } /* end block loop */
+            } /* end object loop */
+oamd_export:
+
+            /* Export to global structure */
+            for (int obj = 0; obj < oamd.num_objects; obj++)
+                g_spatial_ext_objmeta.objects[obj] = oamd.objects[obj];
+            g_spatial_ext_objmeta.num_objects = oamd.num_objects;
+            g_spatial_ext_objmeta.num_bed_objects = oamd.num_bed_objects;
+            g_spatial_ext_objmeta.num_dynamic_objects = oamd.num_dynamic_objects;
+            g_spatial_ext_objmeta.sample_offset = oamd.sample_offset;
+            g_spatial_ext_objmeta.ramp_duration = oamd.ramp_duration;
+            atomic_store(&g_spatial_ext_objmeta.updated, 1);
+            ((MLPDecodeContext *)avctx->priv_data)->objmeta_updated_au = 1;
+
+            { /* Debug: log ALL object positions every ~50 frames */
+                static int oamd_dbg_cnt = 0;
+                if (++oamd_dbg_cnt % 50 == 1) {
+                    av_log(avctx, AV_LOG_DEBUG,
+                           "OAMD[%d]: nblk=%d obj=%d bed=%d isf=%d dyn=%d beds_or_isf=%d\n",
+                           oamd_dbg_cnt, num_blocks, oamd.num_objects,
+                           oamd.num_bed_objects, num_isf,
+                           oamd.num_dynamic_objects, beds_or_isf);
+                    for (int obj = 0; obj < oamd.num_objects; obj++)
+                        av_log(avctx, AV_LOG_DEBUG,
+                               "  [%d] act=%d x=%+.3f y=%+.3f z=%+.3f g=%d sz=%.2f\n",
+                               obj, oamd.objects[obj].active,
+                               oamd.objects[obj].x, oamd.objects[obj].y,
+                               oamd.objects[obj].z, oamd.objects[obj].gain_db,
+                               oamd.objects[obj].size);
+                }
+            }
+
+            return 0;
+        }
+
+        /* Skip unknown element types using elem_size_bits */
+        int consumed = get_bits_count(&gb) - elem_start;
+        int skip = elem_size_bits - consumed;
+        if (skip > 0 && skip <= get_bits_left(&gb))
+            skip_bits(&gb, skip);
+    }
+
+    return -1;
+}
+
+/** Parse ExtraData and EVO frame after substreams to find object metadata.
+ *  buf points to the first byte after all substream data.
+ *  remaining is the number of bytes left in the access unit. */
+static void parse_extra_data_objmeta(AVCodecContext *avctx,
+                                  const uint8_t *buf, int remaining)
+{
+    GetBitContext gb;
+
+    if (remaining < 4)
+        return;
+
+    init_get_bits(&gb, buf, remaining * 8);
+
+    /* ExtraData header: 4-bit check + 12-bit length (in 16-bit words) */
+    skip_bits(&gb, 4); /* check_nibble */
+    int extra_len_words = get_bits(&gb, 12);
+    int extra_len_bytes = extra_len_words * 2;
+
+    if (extra_len_bytes < 2 || extra_len_bytes + 2 > remaining)
+        return;
+
+    /* EVO frame: 4-bit reserved + 12-bit byte length */
+    skip_bits(&gb, 4); /* evo_reserved */
+    int evo_byte_len = get_bits(&gb, 12);
+
+    if (evo_byte_len < 2 || evo_byte_len > extra_len_bytes)
+        return;
+
+    /* EVO frame content starts here */
+    /* evo_version: 2 bits (if 3, read more) */
+    int evo_ver = get_bits(&gb, 2);
+    if (evo_ver == 3)
+        evo_ver += oamd_get_variable(&gb, 2, 16);
+
+    /* key_id: 3 bits (if 7, read more) */
+    int key_id = get_bits(&gb, 3);
+    if (key_id == 7)
+        key_id += oamd_get_variable(&gb, 3, 10);
+    (void)evo_ver;
+    (void)key_id;
+
+    /* EVO payloads: loop until payload_id == 0 */
+    while (get_bits_left(&gb) >= 8) {
+        int payload_id = get_bits(&gb, 5);
+        if (payload_id == 31)
+            payload_id += oamd_get_variable(&gb, 5, 8);
+        if (payload_id == 0)
+            break; /* terminator */
+
+        /* EvoPayloadConfig (matches truehdd evolution.rs) */
+        uint32_t smploffst = 0;
+        int has_smploffst = 0;
+
+        /* smploffst */
+        if (get_bits1(&gb)) {
+            smploffst = oamd_get_variable(&gb, 11, 2);
+            has_smploffst = 1;
+        }
+        /* duration */
+        if (get_bits1(&gb))
+            oamd_get_variable(&gb, 11, 2); /* discard */
+        /* groupid */
+        if (get_bits1(&gb))
+            oamd_get_variable(&gb, 2, 16); /* discard */
+        /* codedcdata */
+        if (get_bits1(&gb))
+            skip_bits(&gb, 8); /* discard */
+        /* discard_unknown_payload (inverted flag) */
+        if (!get_bits1(&gb)) {
+            int payload_frame_aligned = 0;
+            if (!has_smploffst)
+                payload_frame_aligned = get_bits1(&gb);
+            if (payload_frame_aligned) {
+                skip_bits(&gb, 1); /* create_duplicate */
+                skip_bits(&gb, 1); /* remove_duplicate */
+            }
+            if (has_smploffst || payload_frame_aligned) {
+                skip_bits(&gb, 5); /* priority */
+                skip_bits(&gb, 2); /* proc_allowed */
+            }
+        }
+
+        /* evo_payload_size: number of bytes, then read each byte */
+        uint32_t payload_size = oamd_get_variable(&gb, 8, 4);
+
+        if (payload_size * 8 > (unsigned)get_bits_left(&gb))
+            return;
+
+        if (payload_id == 11 && payload_size > 0) {
+            /* Extract full object metadata payload bytes from bitstream.
+             * Some titles carry larger OAMD payloads; truncation can
+             * desync parsing and cause unstable object extraction. */
+            uint8_t oamd_buf[4096];
+            if (payload_size > sizeof(oamd_buf)) {
+                av_log(avctx, AV_LOG_WARNING,
+                       "OAMD payload too large (%u bytes), skipping\n",
+                       payload_size);
+                skip_bits(&gb, payload_size * 8);
+                continue;
+            }
+            for (uint32_t i = 0; i < payload_size; i++)
+                oamd_buf[i] = get_bits(&gb, 8);
+            if (parse_oamd_payload(avctx, oamd_buf, payload_size, smploffst) < 0) {
+                av_log(avctx, AV_LOG_DEBUG, "OAMD payload parse failed\n");
+            }
+            continue;
+        }
+
+        /* Skip unknown/unused payload bytes */
+        skip_bits(&gb, payload_size * 8);
+    }
+}
