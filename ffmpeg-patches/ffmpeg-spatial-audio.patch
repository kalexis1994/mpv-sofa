+static int objcoding_huff_decode(EmdfBitReader *br, const int table[][2]) {
+    int node = 0;
+    do {
+        if (emdf_br_left(br) < 1) return 0;
+        int bit = emdf_br_read(br, 1);
+        node = table[node][bit];
+    } while (node > 0);
+    return (-node - 1);
+}
