+/** Parse ExtraData and EVO frame after substreams to find object metadata.
+ *  buf points to the first byte after all substream data.
+ *  remaining is the number of bytes left in the access unit. */
+static void parse_extra_data_objmeta(AVCodecContext *avctx,
+                                  const uint8_t *buf, int remaining)
+{
+    GetBitContext gb;
+
+    if (remaining < 4)
+        return;
+
+    init_get_bits(&gb, buf, remaining * 8);
+
+    /* ExtraData header: 4-bit check + 12-bit length (in 16-bit words) */
+    skip_bits(&gb, 4); /* check_nibble */
+    int extra_len_words = get_bits(&gb, 12);
+    int extra_len_bytes = extra_len_words * 2;
+
+    if (extra_len_bytes < 2 || extra_len_bytes + 2 > remaining)
+        return;
+
+    /* EVO frame: 4-bit reserved + 12-bit byte length */
+    skip_bits(&gb, 4); /* evo_reserved */
+    int evo_byte_len = get_bits(&gb, 12);
+
+    if (evo_byte_len < 2 || evo_byte_len > extra_len_bytes)
+        return;
+
+    /* EVO frame content starts here */
+    /* evo_version: 2 bits (if 3, read more) */
+    int evo_ver = get_bits(&gb, 2);
+    if (evo_ver == 3)
+        evo_ver += oamd_get_variable(&gb, 2, 16);
+
+    /* key_id: 3 bits (if 7, read more) */
+    int key_id = get_bits(&gb, 3);
+    if (key_id == 7)
+        key_id += oamd_get_variable(&gb, 3, 10);
+    (void)evo_ver;
+    (void)key_id;
+
+    /* EVO payloads: loop until payload_id == 0 */
+    while (get_bits_left(&gb) >= 8) {
+        int payload_id = get_bits(&gb, 5);
+        if (payload_id == 0)
+            break; /* terminator */
+
+        /* EvoPayloadConfig (matches truehdd evolution.rs) */
+        uint32_t smploffst = 0;
+        int has_smploffst = 0;
+
+        /* smploffst */
+        if (get_bits1(&gb)) {
+            smploffst = oamd_get_variable(&gb, 11, 2);
+            has_smploffst = 1;
+        }
+        /* duration */
+        if (get_bits1(&gb))
+            oamd_get_variable(&gb, 11, 2); /* discard */
+        /* groupid */
+        if (get_bits1(&gb))
+            oamd_get_variable(&gb, 2, 16); /* discard */
+        /* codedcdata */
+        if (get_bits1(&gb))
+            skip_bits(&gb, 8); /* discard */
+        /* discard_unknown_payload (inverted flag) */
+        if (!get_bits1(&gb)) {
+            int payload_frame_aligned = 0;
+            if (!has_smploffst)
+                payload_frame_aligned = get_bits1(&gb);
+            if (payload_frame_aligned) {
+                skip_bits(&gb, 1); /* create_duplicate */
+                skip_bits(&gb, 1); /* remove_duplicate */
+            }
+            if (has_smploffst || payload_frame_aligned) {
+                skip_bits(&gb, 5); /* priority */
+                skip_bits(&gb, 2); /* proc_allowed */
+            }
+        }
+
+        /* evo_payload_size: number of bytes, then read each byte */
+        uint32_t payload_size = oamd_get_variable(&gb, 8, 4);
+
+        if (payload_id == 11 && payload_size > 0 &&
+            (int)payload_size * 8 <= get_bits_left(&gb)) {
+            /* Extract object metadata payload bytes from the bitstream */
+            uint8_t oamd_buf[512];
+            uint32_t copy_size = FFMIN(payload_size, sizeof(oamd_buf));
+            for (uint32_t i = 0; i < copy_size; i++)
+                oamd_buf[i] = get_bits(&gb, 8);
+            parse_oamd_payload(avctx, oamd_buf, copy_size, smploffst);
+            return; /* done after first object metadata */
+        }
+
+        /* Skip payload bytes */
+        if (payload_size * 8 > (unsigned)get_bits_left(&gb))
+            return;
+        skip_bits(&gb, payload_size * 8);
+    }
+}
