+/* Build a safe output_shift map that avoids 24-bit saturation in pack_output.
+ * This preserves channel balance as much as possible while preventing hard clips
+ * on peak passages in spatial/object extraction. */
+static int build_safe_output_shift(int32_t (*sample_buffer)[MAX_CHANNELS],
+                                   uint16_t blockpos,
+                                   uint8_t max_matrix_channel,
+                                   const uint8_t *ch_assign,
+                                   const int8_t *input_shift,
+                                   int8_t *safe_shift,
+                                   uint8_t *headroom_state,
+                                   uint8_t *extra_rshift,
+                                   int *attenuated_channels)
+{
+    uint8_t used[MAX_CHANNELS] = {0};
+    int adjusted = 0;
+
+    memcpy(safe_shift, input_shift, sizeof(int8_t) * MAX_CHANNELS);
+    memset(extra_rshift, 0, sizeof(uint8_t) * MAX_CHANNELS);
+    *attenuated_channels = 0;
+    if (!headroom_state)
+        return 0;
+
+    for (unsigned int out_ch = 0; out_ch <= max_matrix_channel; out_ch++) {
+        int mat_ch = ch_assign[out_ch];
+        if (mat_ch >= 0 && mat_ch < MAX_CHANNELS)
+            used[mat_ch] = 1;
+    }
+
+    for (unsigned int mat_ch = 0; mat_ch < MAX_CHANNELS; mat_ch++) {
+        int shift;
+        int64_t peak = 0;
+        uint8_t needed = 0;
+        uint8_t prev;
+
+        if (!used[mat_ch])
+            continue;
+
+        shift = input_shift[mat_ch];
+        if (shift < 0)
+            shift = 0;
+        if (shift > 30)
+            shift = 30;
+
+        for (unsigned int i = 0; i < blockpos; i++) {
+            int64_t v = sample_buffer[i][mat_ch];
+            if (v < 0)
+                v = -v;
+            if (v > peak)
+                peak = v;
+        }
+
+        if (shift > 0) {
+            if (peak > (INT64_MAX >> shift))
+                peak = INT64_MAX;
+            else
+                peak <<= shift;
+        }
+
+        while (peak > 8388607 && needed < 31) {
+            peak = (peak + 1) >> 1;
+            needed++;
+        }
+
+        prev = headroom_state[mat_ch];
+        if (needed > headroom_state[mat_ch])
+            headroom_state[mat_ch] = needed;
+        if (headroom_state[mat_ch] != prev)
+            adjusted = 1;
+
+        extra_rshift[mat_ch] = headroom_state[mat_ch];
+        if (headroom_state[mat_ch]) {
+            int new_shift = shift - headroom_state[mat_ch];
+            if (new_shift < 0)
+                new_shift = 0;
+            safe_shift[mat_ch] = new_shift;
+            (*attenuated_channels)++;
+        }
+    }
+
+    return adjusted;
+}
