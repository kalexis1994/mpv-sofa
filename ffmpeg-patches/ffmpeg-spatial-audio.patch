+                            b_sparse[obj], quant_idx[obj], slope_idx[obj],
+                            num_dpoints[obj], g_objcoding_data.mix_mtx[obj][0][0][0]);
+                fclose(dbg);
+            }
+            objcoding_log_count++;
+        }
+    }
+
+    return 0;
+}
