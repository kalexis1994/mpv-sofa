-/**
- * Uninitialize the AC-3 decoder.
- */
-static av_cold int ac3_decode_end(AVCodecContext *avctx)
-{
-    AC3DecodeContext *s = avctx->priv_data;
-    av_tx_uninit(&s->tx_256);
-    av_tx_uninit(&s->tx_128);
-    av_freep(&s->fdsp);
-    av_freep(&s->downmix_coeffs[0]);
-
-    return 0;
-}
